SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional, only to run migrations: the session pooler URI (Connect > Session pooler).
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
CLASS_CODE=your-class-code
# Comma-separated. Defaults to http://localhost:5173.
CORS_ORIGINS=http://localhost:5173
# The language the AI writes the shared notes and pages in (en, es), until an admin sets it
# in the admin panel. Defaults to en.
CLASS_LANGUAGE=en

# The daily pass. Any OpenAI-compatible endpoint works.
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Optional: a web model that writes the pages as OpenUI Lang first. When it fails (or these are
# empty), the LLM_* model above writes them. Any OpenAI-compatible endpoint; WEB_PROMPT=gateway
# is for one that builds the prompt itself, such as the OpenUI Gateway:
#   WEB_BASE_URL=https://api.thesys.dev/v1/embed  WEB_MODEL=google/gemini-3.7-flash
WEB_API_KEY=
WEB_BASE_URL=
WEB_MODEL=
WEB_PROMPT=full
