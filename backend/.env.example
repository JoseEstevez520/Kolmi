SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional, only to run migrations: the session pooler URI (Connect > Session pooler).
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
CLASS_CODE=your-class-code
# Comma-separated. Defaults to http://localhost:5173.
CORS_ORIGINS=http://localhost:5173
# The language the AI writes the shared notes and pages in (en, es), until an admin sets it
# in the admin panel. Defaults to en.
CLASS_LANGUAGE=en

# The daily pass. Any OpenAI-compatible endpoint works.
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# The web agent writes pages as OpenUI Lang. deepseek (the default) uses the LLM_* model above;
# thesys goes through the Thesys (OpenUI) Gateway and needs the key below. Model ids there are
# {provider}/{model}.
WEB_PROVIDER=deepseek
THESYS_API_KEY=your-thesys-api-key
THESYS_BASE_URL=https://api.thesys.dev/v1/embed
THESYS_MODEL=google/gemini-3.7-flash
