SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional, only to run migrations: the session pooler URI (Connect > Session pooler).
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
CLASS_CODE=your-class-code
# Comma-separated. Defaults to http://localhost:5173.
CORS_ORIGINS=http://localhost:5173
# The language the AI writes the shared notes and pages in (en, es), until an admin sets it
# in the admin panel. Defaults to en.
CLASS_LANGUAGE=en

# The main model: the daily pass, the fallback for the pages, and the one that draws a page's
# SVG figures and interactive pieces (only when a page asks for one). Any OpenAI-compatible
# endpoint works. A capable model pays off here; on DeepSeek, deepseek-v4-pro.
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# Optional: a faster model for the chat only (same endpoint and key). Empty, the chat uses LLM_MODEL.
CHAT_MODEL=

# Optional: a web model suited to OpenUI Lang that composes the pages and their figures first.
# When it fails (or these are empty), the LLM_* model above writes them. Any OpenAI-compatible
# endpoint; WEB_PROMPT=gateway is for one that builds the prompt itself, such as the OpenUI
# Gateway. Either of:
#   WEB_BASE_URL=https://api.thesys.dev/v1/embed  WEB_MODEL=google/gemini-3.7-flash  WEB_PROMPT=gateway
#   WEB_BASE_URL=https://api.deepseek.com  WEB_MODEL=deepseek-flash  (and the DeepSeek key)
WEB_API_KEY=
WEB_BASE_URL=
WEB_MODEL=
WEB_PROMPT=full

# Optional: search by meaning, so the chat finds the right part of a page as the notes grow.
# The pages are cut into chunks and embedded into Supabase (pgvector); without a key the chat
# and search_pages match words instead. DeepSeek has no embeddings endpoint: OpenAI's
# text-embedding-3-small costs $0.02 per million tokens. Any OpenAI-compatible endpoint works
# if its model can return 1536 dimensions. After setting it, index what is already there with
# `python -m app.rag reindex` (and `--force` after changing the model).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
