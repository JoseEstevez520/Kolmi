# Copy this file to `.env` and fill it in. `.env` is gitignored; never commit it.
# The Supabase anon key is public (it is the key the browser uses); the service
# role key is not and lives only in the backend.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Kolmi backend. Defaults to http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000
