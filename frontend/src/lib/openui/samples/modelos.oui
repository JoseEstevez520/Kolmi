root = Page([intro, h1, terms, analogia, h2, p2, chart, tabla, end2, h3, p3, tablaTareas, p4, planFig, end3, tip, h4, p5, cmds, h5, p6, h6, p7, h7, explore, footer])

intro = Text("Un agente es un modelo con herramientas. El **modelo** es el que piensa, y no hay uno mejor para todo: los hay más listos y más caros, y otros rápidos y baratos que para muchas tareas bastan.")

h1 = Heading("Qué cambia entre modelos")
terms = DescriptionList([dCap, dRap, dPre, dCon, dRaz])
dCap = DescriptionItem("Capacidad", "Cuántos pasos seguidos acierta sin perderse. Se mide con pruebas (*benchmarks*) como SWE-bench, que le pide resolver problemas reales de código.")
dRap = DescriptionItem("Rapidez", "Lo que tarda en empezar a responder. En un agente, que da muchas vueltas, se nota.")
dPre = DescriptionItem("Precio", "Lo que cuesta cada millón de *tokens*, los trozos de texto en que se parte lo que escribes, de entrada y de salida.")
dCon = DescriptionItem("Contexto", "Cuánto texto le cabe a la vez.")
dRaz = DescriptionItem("Razonamiento", "Si piensa antes de responder. Acierta más en lo difícil, pero tarda y cuesta más.")

analogia = Text("Elegir modelo es como elegir vehículo: una furgoneta pequeña para repartir por el barrio, un camión para una mudanza. No coges el camión para comprar el pan.")

h2 = Heading("No siempre el más potente")
p2 = Text("Pagar más no siempre compra más calidad. En estos seis modelos la calidad es casi la misma (en torno al 80 % en SWE-bench) y lo que cambia de verdad es el coste: de veinte céntimos a setenta y cuatro dólares por tarea.")
chart = Chart("Calidad frente a coste por tarea: seis modelos, casi la misma calidad y hasta 370 veces de diferencia en el coste.", [serie], "points", ejeX, ejeY, "Datos de AgentMarketCap, abril de 2026, sobre 2 millones de tokens por tarea. Cambian a menudo.")
serie = ChartSeries("Calidad (SWE-bench) frente a coste por tarea", [pt1, pt2, pt3, pt4, pt5, pt6])
pt1 = {x: 0.2, y: 79.3, label: "DeepSeek V4 Pro"}
pt2 = {x: 0.46, y: 80.2, label: "Qwen3.5"}
pt3 = {x: 1.31, y: 80.6, label: "MiniMax M2.5"}
pt4 = {x: 11, y: 80.8, label: "Gemini 3.1 Pro"}
pt5 = {x: 18, y: 80.6, label: "GPT-5.4"}
pt6 = {x: 74, y: 80.8, label: "Claude Opus 4.6"}
ejeX = {title: "Coste por tarea resuelta", unit: "$", scale: "log"}
ejeY = {title: "SWE-bench Verified", unit: "%", scale: "linear", min: 78, max: 82}

tabla = Table(["Modelo", "SWE-bench Verified", "Coste por tarea resuelta"], [["DeepSeek V4 Pro", "79,3 %", "$0,20"], ["Qwen3.5", "80,2 %", "$0,46"], ["MiniMax M2.5", "80,6 %", "$1,31"], ["Gemini 3.1 Pro", "80,8 %", "$11"], ["GPT-5.4", "80,6 %", "$18"], ["Claude Opus 4.6", "80,8 %", "$74"]])
end2 = Text("**Pagar más no compra más: lo que cambia entre estos modelos es el coste, no la calidad.**")

h3 = Heading("Repartir el trabajo")
p3 = Text("Lo interesante no es usar siempre el modelo más potente, sino darle a cada tarea el que le vale.")
tablaTareas = Table(["Lo que haces", "Con qué"], [["Autocompletar, resumir, renombrar, un test sencillo", "barato y rápido"], ["Una feature normal, leyendo el código", "el de en medio"], ["Depurar algo difícil, decidir la arquitectura, un refactor grande", "el más potente"]])
p4 = Text("Una práctica común es que el más listo haga el **plan** y el barato lo **ejecute**: en el plan se decide bien o mal, y ejecutar es seguir unos pasos, que no necesita tanta cabeza.")
planFig = Figure("La tarea se parte en dos: el modelo potente decide el plan y el barato ejecuta los pasos.", [areaPlan, flecha, areaEjec])
areaPlan = Area("Plan", [chipPotente], "violet", "brain", "Aquí se decide bien o mal.")
chipPotente = Chip("Modelo potente")
flecha = Arrow("los pasos")
areaEjec = Area("Ejecución", [chipBarato], "cyan", "list-checks", "Seguir pasos no necesita tanta cabeza.")
chipBarato = Chip("Modelo barato")
end3 = Text("**El que decide es el potente; el que ejecuta, el barato.**")

tip = Callout("tip", "Para el uso del día a día no hace falta darle muchas vueltas: coge uno bueno y listo. Saberlo vale para optimizar, bajando de modelo en lo fácil.")

h4 = Heading("Cómo se elige en OpenCode")
p5 = Text("En el chat, `/models` abre el selector de modelos. También se puede fijar al arrancar o en la configuración: en `opencode.json` se deja el de por defecto, y `opencode stats --models` enseña lo que gastas por modelo.")
cmds = CodeBlock("opencode models                     # lista los modelos que tienes\nopencode --model proveedor/modelo   # arranca con ese", "bash")

h5 = Heading("El contexto se llena")
p6 = Text("A un modelo solo le cabe un trozo de conversación. Cuando la charla se hace muy larga se pierde: cuesta más y acierta menos. Es como una mesa: con dos papeles los ves, con doscientos no encuentras nada. Por eso el agente resume lo viejo, y conviene abrir una sesión nueva para otro tema.")

h6 = Heading("Modelos pequeños y específicos")
p7 = Text("Además de generalistas cada vez más listos, van a crecer los pequeños centrados en una sola cosa. Como en un equipo: a cada recado, quien mejor lo hace.")

h7 = Heading("Para explorar")
explore = Text("- [Modelos en OpenCode](https://opencode.ai/docs/models/).\n- [models.dev](https://models.dev): el catálogo de modelos y proveedores.\n- [Artificial Analysis](https://artificialanalysis.ai/): calidad frente a coste.\n- [SWE-bench](https://www.swebench.com/): la prueba de código que enseña la gráfica.")

footer = Text("**3 de 9** · Anterior: [Tu primer agente](../opencode/) · Siguiente: [Darle contexto](../contexto/)")
