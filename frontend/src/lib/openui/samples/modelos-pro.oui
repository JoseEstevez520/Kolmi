root = Page([intro, cambios_heading, cambios_text, vehiculos, no_siempre_heading, antes_diagrama, diagrama, despues_diagrama, tabla_antes, tabla_modelos, tabla_nota, repartir_heading, repartir_text, tabla_tareas, practica, tip, opencode_heading, opencode_text, codigo, opencode_config, contexto_heading, contexto_text, futuro_heading, futuro_text, explorar_heading, explorar_links])
intro = Text("Un agente es un modelo con herramientas. El **modelo** es el que piensa, y no hay uno mejor para todo: hay modelos más listos y más caros, y otros rápidos y baratos que para muchas cosas bastan.")
cambios_heading = Heading("Qué cambia entre modelos")
cambios_text = Text("- **Capacidad:** cuántos pasos seguidos acierta sin perderse. Se mide con pruebas (benchmarks), como SWE-bench.\n- **Rapidez:** lo que tarda en empezar a responder. En un agente, que da muchas vueltas, se nota.\n- **Precio:** lo que cuesta cada millón de tokens, de entrada y de salida.\n- **Contexto:** cuánto texto le cabe a la vez.\n- **Razonamiento:** si \"piensa\" antes de responder. Acierta más en lo difícil, pero tarda y cuesta más.")
vehiculos = Text("Piensa en vehículos: una furgoneta pequeña para repartir por el barrio, un camión para una mudanza. No coges el camión para comprar el pan.")
no_siempre_heading = Heading("No siempre el más potente")
antes_diagrama = Text("Pagar más no siempre compra más calidad. La gráfica superpone calidad y coste por tarea:")
diagrama = Diagram("Calidad frente a coste por tarea", "Dispersión con eje X coste por tarea resuelta en dólares (escala logarítmica), eje Y porcentaje SWE-bench Verified. Seis puntos casi horizontales: DeepSeek V4 Pro (79,3 %, $0,20) abajo a la izquierda; Qwen3.5 (80,2 %, $0,46), MiniMax M2.5 (80,6 %, $1,31), Gemini 3.1 Pro (80,8 %, $11), GPT-5.4 (80,6 %, $18) y Claude Opus 4.6 (80,8 %, $74) suben muy poco y se van a la derecha. Colorear los puntos de verde a rojo según el coste. Lo que hay que notar: casi la misma calidad con costes muy distintos.", null, "<svg viewBox=\"0 0 640 480\" xmlns=\"http://www.w3.org/2000/svg\">\n  <defs>\n    <marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\">\n      <path d=\"M 0 0 L 10 5 L 0 10 z\" class=\"diagram-line\" />\n    </marker>\n  </defs>\n\n  <!-- Grid lines -->\n  <g class=\"diagram-grid\">\n    <!-- Horizontal (Y-axis) grid lines -->\n    <line x1=\"80\" y1=\"400\" x2=\"580\" y2=\"400\" />\n    <line x1=\"80\" y1=\"368\" x2=\"580\" y2=\"368\" />\n    <line x1=\"80\" y1=\"336\" x2=\"580\" y2=\"336\" />\n    <line x1=\"80\" y1=\"304\" x2=\"580\" y2=\"304\" />\n    <line x1=\"80\" y1=\"272\" x2=\"580\" y2=\"272\" />\n    <line x1=\"80\" y1=\"240\" x2=\"580\" y2=\"240\" />\n    <line x1=\"80\" y1=\"208\" x2=\"580\" y2=\"208\" />\n    <line x1=\"80\" y1=\"176\" x2=\"580\" y2=\"176\" />\n    <line x1=\"80\" y1=\"144\" x2=\"580\" y2=\"144\" />\n    <line x1=\"80\" y1=\"112\" x2=\"580\" y2=\"112\" />\n    <line x1=\"80\" y1=\"80\" x2=\"580\" y2=\"80\" />\n    \n    <!-- Vertical (X-axis) grid lines -->\n    <line x1=\"80\" y1=\"400\" x2=\"80\" y2=\"80\" />\n    <line x1=\"130\" y1=\"400\" x2=\"130\" y2=\"80\" />\n    <line x1=\"196\" y1=\"400\" x2=\"196\" y2=\"80\" />\n    <line x1=\"246.66\" y1=\"400\" x2=\"246.66\" y2=\"80\" />\n    <line x1=\"296.66\" y1=\"400\" x2=\"296.66\" y2=\"80\" />\n    <line x1=\"363.33\" y1=\"400\" x2=\"363.33\" y2=\"80\" />\n    <line x1=\"413.33\" y1=\"400\" x2=\"413.33\" y2=\"80\" />\n    <line x1=\"463.33\" y1=\"400\" x2=\"463.33\" y2=\"80\" />\n    <line x1=\"530\" y1=\"400\" x2=\"530\" y2=\"80\" />\n    <line x1=\"580\" y1=\"400\" x2=\"580\" y2=\"80\" />\n  </g>\n\n  <!-- Axes -->\n  <g class=\"diagram-line\">\n    <line x1=\"80\" y1=\"400\" x2=\"580\" y2=\"400\" marker-end=\"url(#arrow)\" />\n    <line x1=\"80\" y1=\"400\" x2=\"80\" y2=\"80\" marker-end=\"url(#arrow)\" />\n  </g>\n\n  <!-- Axis Titles -->\n  <text x=\"330\" y=\"455\" text-anchor=\"middle\" class=\"diagram-text\" font-size=\"13\">Coste por tarea resuelta (USD, escala log)</text>\n  <text transform=\"translate(35, 240) rotate(-90)\" text-anchor=\"middle\" class=\"diagram-text\" font-size=\"13\">SWE-bench Verified (%)</text>\n\n  <!-- Y-axis Tick Labels -->\n  <g class=\"diagram-text\" font-size=\"12\">\n    <text x=\"70\" y=\"404\" text-anchor=\"end\">75%</text>\n    <text x=\"70\" y=\"244\" text-anchor=\"end\">80%</text>\n    <text x=\"70\" y=\"84\" text-anchor=\"end\">85%</text>\n  </g>\n\n  <!-- X-axis Tick Labels -->\n  <g class=\"diagram-text\" font-size=\"12\">\n    <text x=\"80\" y=\"420\" text-anchor=\"middle\">$0.1</text>\n    <text x=\"246.66\" y=\"420\" text-anchor=\"middle\">$1</text>\n    <text x=\"413.33\" y=\"420\" text-anchor=\"middle\">$10</text>\n    <text x=\"580\" y=\"420\" text-anchor=\"middle\">$100</text>\n  </g>\n\n  <!-- Connecting Line (Trend) -->\n  <polyline points=\"130,262.4 190,233.6 266,220.8 420,214.4 456,220.8 558,214.4\" class=\"diagram-quiet\" fill=\"none\" />\n\n  <!-- Emphasis Annotation -->\n  <g class=\"diagram-emphasis\" style=\"--diagram-color: var(--color-fg-muted)\">\n    <text x=\"380\" y=\"170\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"600\">Casi la misma calidad</text>\n    <path d=\"M 420 165 L 420 205\" fill=\"none\" class=\"diagram-line\" marker-end=\"url(#arrow)\" />\n  </g>\n\n  <!-- Data Points -->\n  <!-- DeepSeek V4 Pro: 79.3%, $0.20 -->\n  <g style=\"--diagram-color: #16a34a\">\n    <circle class=\"diagram-part\" cx=\"130\" cy=\"262.4\" r=\"7\" />\n    <text x=\"130\" y=\"280\" text-anchor=\"start\" class=\"diagram-label\" font-size=\"12\">DeepSeek V4 Pro</text>\n  </g>\n\n  <!-- Qwen3.5: 80.2%, $0.46 -->\n  <g style=\"--diagram-color: #84cc16\">\n    <circle class=\"diagram-part\" cx=\"190\" cy=\"233.6\" r=\"7\" />\n    <text x=\"190\" y=\"205\" text-anchor=\"start\" class=\"diagram-label\" font-size=\"12\">Qwen3.5</text>\n  </g>\n\n  <!-- MiniMax M2.5: 80.6%, $1.31 -->\n  <g style=\"--diagram-color: #eab308\">\n    <circle class=\"diagram-part\" cx=\"266\" cy=\"220.8\" r=\"7\" />\n    <text x=\"266\" y=\"195\" text-anchor=\"middle\" class=\"diagram-label\" font-size=\"12\">MiniMax M2.5</text>\n  </g>\n\n  <!-- Gemini 3.1 Pro: 80.8%, $11 -->\n  <g style=\"--diagram-color: #f97316\">\n    <circle class=\"diagram-part\" cx=\"420\" cy=\"214.4\" r=\"7\" />\n    <text x=\"420\" y=\"185\" text-anchor=\"middle\" class=\"diagram-label\" font-size=\"12\">Gemini 3.1 Pro</text>\n  </g>\n\n  <!-- GPT-5.4: 80.6%, $18 -->\n  <g style=\"--diagram-color: #ea580c\">\n    <circle class=\"diagram-part\" cx=\"456\" cy=\"220.8\" r=\"7\" />\n    <text x=\"456\" y=\"250\" text-anchor=\"middle\" class=\"diagram-label\" font-size=\"12\">GPT-5.4</text>\n  </g>\n\n  <!-- Claude Opus 4.6: 80.8%, $74 -->\n  <g style=\"--diagram-color: #dc2626\">\n    <circle class=\"diagram-part\" cx=\"558\" cy=\"214.4\" r=\"7\" />\n    <text x=\"560\" y=\"235\" text-anchor=\"end\" class=\"diagram-label\" font-size=\"12\">Claude Opus 4.6</text>\n  </g>\n</svg>")
despues_diagrama = Text("**Casi horizontal: seis modelos rondan el 80 % aunque el coste va de veinte céntimos a setenta y cuatro dólares.**")
tabla_antes = Text("Los números de la gráfica:")
tabla_modelos = Table(["Modelo", "SWE-bench Verified", "Coste por tarea resuelta"], [["DeepSeek V4 Pro", "79,3 %", "$0,20"], ["Qwen3.5", "80,2 %", "$0,46"], ["MiniMax M2.5", "80,6 %", "$1,31"], ["Gemini 3.1 Pro", "80,8 %", "$11"], ["GPT-5.4", "80,6 %", "$18"], ["Claude Opus 4.6", "80,8 %", "$74"]])
tabla_nota = Text("**No pagues más por el mismo acierto.** Datos de AgentMarketCap, abril de 2026, sobre 2 millones de tokens por tarea. Cambian a menudo.")
repartir_heading = Heading("Repartir el trabajo")
repartir_text = Text("Lo interesante no es usar siempre el modelo más potente: es darle a cada tarea el que le vale.")
tabla_tareas = Table(["Lo que haces", "Con qué"], [["Autocompletar, resumir, renombrar, un test sencillo", "barato y rápido"], ["Una funcionalidad normal, leyendo el código", "el de en medio"], ["Depurar algo difícil, decidir la arquitectura, un refactor grande", "el más potente"]])
practica = Text("Una práctica común: el más listo hace el **plan** y el barato lo **ejecuta**. En el plan se decide bien o mal; ejecutar es seguir unos pasos, que no necesita tanta cabeza.")
tip = Callout("tip", "Para el usuario promedio no hace falta comerse la cabeza: coge uno bueno y listo. Saberlo vale para optimizar, bajando de modelo en lo fácil.")
opencode_heading = Heading("Cómo se elige en OpenCode")
opencode_text = Text("En la terminal, `/models` abre el selector dentro del chat. También se puede fijar al arrancar o en la configuración:")
codigo = CodeBlock("opencode models                     # lista los modelos que tienes\nopencode --model proveedor/modelo   # arranca con ese", "bash", "terminal")
opencode_config = Text("En `opencode.json` se deja el de por defecto, y `opencode stats --models` enseña lo que gastas por modelo.")
contexto_heading = Heading("El contexto se llena")
contexto_text = Text("A un modelo solo le cabe un trozo de conversación. Cuando la charla se hace muy larga, se pierde: cuesta más y acierta menos. Es como una mesa: con dos papeles los ves, con doscientos no encuentras nada. Por eso el agente resume lo viejo, y conviene abrir una sesión nueva para otro tema.")
futuro_heading = Heading("A dónde va esto")
futuro_text = Text("Además de generalistas cada vez más listos, van a crecer los **pequeños y específicos**, buenos en una sola cosa. Es como un equipo: a cada recado, quien mejor lo hace.")
explorar_heading = Heading("Para explorar")
explorar_links = Text("- [Modelos en OpenCode](https://opencode.ai/docs/models/)\n- [models.dev](https://models.dev), el catálogo de modelos y proveedores\n- [Artificial Analysis](https://artificialanalysis.ai/), calidad frente a coste\n- [SWE-bench](https://www.swebench.com/), la prueba de código que enseña la gráfica")
