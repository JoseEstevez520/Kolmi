root = Page([intro, hProblema, pProblema, preFig, fig, postFig, hControlador, pControlador, walk, postWalk, hVarias, pVarias, codeVarias, hPrefijo, pPrefijo, codePrefijo, hPathVar, pPathVar, codePathVar, hQuery, pQuery, codeQuery, pQuery2, tblQuery, pReq, codeReq, pOpt, codeOpt, hModel, pModel, codeModel, hTipos, pTipos, tblTipos, pTipos2, hEstaticos, pEstaticos, treeEstaticos, hExplorar, pExplorar])

intro = Text("Cuando el navegador pide una URL, alguien en el servidor tiene que decidir qué responder. De eso se encarga el **controlador**: recibe las peticiones y las lleva al método que toca.")

hProblema = Heading("Problema")
pProblema = Text("El navegador (o Postman, para probar) manda **peticiones HTTP**: pide una dirección como `http://localhost:8080/products/` y espera una respuesta. El servidor necesita saber qué método ejecutar para cada dirección.")
preFig = Text("Fíjate en el recorrido: la petición entra, el controlador busca el método de esa ruta y sale una respuesta.")
fig = Figure("Una petición HTTP entra desde el navegador o Postman, el controlador la lleva al método de esa ruta y la respuesta sale como vista HTML o como datos JSON.", [cliente, a1, controlador, a2, salida])
cliente = Area("Cliente", [c1, c2], "blue", "globe", "Pide una URL.", "row")
c1 = Chip("Navegador")
c2 = Chip("Postman")
a1 = Arrow("petición HTTP")
controlador = Area("Controlador", [r1], "violet", "route", "Busca el método de esa ruta.")
r1 = Chip("método para la dirección")
a2 = Arrow("respuesta")
salida = Group([vista, datos], "column")
vista = Area("Vista (HTML)", [], "cyan", "file-code", "@Controller")
datos = Area("Datos (JSON)", [], "pink", "braces", "@RestController")
postFig = Text("**El mismo recorrido termina en una vista HTML o en datos JSON, según el controlador.**")

hControlador = Heading("Controlador")
pControlador = Text("Un **controlador** es la clase que recibe las peticiones HTTP del cliente y decide qué hacer con ellas. Se marca con `@Controller`, y Spring lo crea como un bean.")
walk = CodeWalkthrough([w1, w2], "HomeController.java")
w1 = WalkthroughStep("La clase", "El controlador empieza siendo una clase vacía marcada con `@Controller`.", "@Controller\npublic class HomeController { }", "1-2")
w2 = WalkthroughStep("La ruta", "`@GetMapping` asocia una ruta a un método, para las peticiones GET (las de abrir una página). El método devuelve el nombre de la vista, y su archivo sale de `templates/`.", "@Controller\npublic class HomeController {\n\n    @GetMapping(\"/\")\n    public String index() {\n        return \"index\";   // templates/index.html\n    }\n}", "4-7")
postWalk = Text("**Cada método con `@GetMapping` atiende una ruta y devuelve el nombre de la vista.**")

hVarias = Heading("Varias rutas en una")
pVarias = Text("Dentro de la anotación caben varias direcciones entre llaves, separadas por comas. Así la misma vista responde en `/`, en `/home` y en la raíz sin nada:")
codeVarias = CodeBlock("@GetMapping({\"/\", \"/home\", \"\"})", "java")

hPrefijo = Heading("Prefijo con @RequestMapping")
pPrefijo = Text("`@RequestMapping` sobre la clase pone un prefijo que se añade a todas sus rutas. Sirve para agrupar y diferenciar las rutas de una parte de la aplicación:")
codePrefijo = CodeBlock("@Controller\n@RequestMapping(\"/products\")\npublic class ProductController {\n\n    @GetMapping(\"/\")             // /products/\n    public String showView() { ... }\n\n    @GetMapping(\"/electronics\")  // /products/electronics\n    public String showElectronics() { ... }\n}", "java")

hPathVar = Heading("Variable en la ruta")
pPathVar = Text("`@PathVariable` coge un trozo variable de la URL y lo pasa como parámetro. Ese trozo se escribe entre llaves:")
codePathVar = CodeBlock("@GetMapping(\"/products/{id}\")\npublic String showProduct(@PathVariable Long id) { ... }", "java")

hQuery = Heading("Parámetro en la query")
pQuery = Text("Un trozo de la ruta va con `@PathVariable`. Lo que va después del `?` va con `@RequestParam`:")
codeQuery = CodeBlock("@GetMapping(\"/products\")\npublic String list(@RequestParam String category, Model model) { ... }", "java")
pQuery2 = Text("Con esa ruta, `/products?category=libros` deja `category` con el valor `libros`.")
tblQuery = Table(["Se escribe", "Se lee con", "Ejemplo"], [["en la ruta: `/products/{id}`", "`@PathVariable`", "`/products/5`"], ["tras el `?`: `?category=libros`", "`@RequestParam`", "`/products?category=libros`"]])
pReq = Text("Si el parámetro puede no venir, no lo dejes obligatorio, o el método responde con un 400:")
codeReq = CodeBlock("@RequestParam(required = false, defaultValue = \"todos\") String category", "java")
pOpt = Text("Con `Optional` lo recibes como un valor que puede faltar y decides tú:")
codeOpt = CodeBlock("@RequestParam Optional<String> category   // category.orElse(\"todos\")", "java")

hModel = Heading("Pasar datos a la vista")
pModel = Text("El controlador le entrega datos a la plantilla con un objeto `Model`. Cada dato lleva un nombre con el que la plantilla lo usa después:")
codeModel = CodeBlock("@GetMapping(\"/saludo\")\npublic String saludo(Model model) {\n    model.addAttribute(\"nombre\", \"Ana\");\n    return \"saludo\";\n}", "java")

hTipos = Heading("Con vista o sin vista")
pTipos = Text("Según lo que devuelva, hay dos tipos de controlador:")
tblTipos = Table(["Anotación", "Devuelve", "Para"], [["`@Controller`", "el nombre de una vista", "una página HTML (MVC)"], ["`@RestController`", "datos, normalmente en JSON", "una API"]])
pTipos2 = Text("En MVC hay vista. En una API hay modelo y controlador, pero no hay vista: el cliente recibe los datos y los pinta él.")

hEstaticos = Heading("Archivos estáticos")
pEstaticos = Text("Las imágenes, el CSS y el JavaScript que no pasan por Thymeleaf van en `static/` (`src/main/resources/static/`).")
treeEstaticos = CodeBlock("src/main/resources/\n├── templates/   vistas\n└── static/      CSS, JavaScript, imágenes", null)

hExplorar = Heading("Para explorar")
pExplorar = Text("- [Mapping Requests](https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-requestmapping.html) en la documentación de Spring.\n- [Annotated Controllers](https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann.html): cómo se declara un controlador.")
