root = Page([intro, h1sing, p1sing, fSing, conclSing, warn, codeSing, h1proto, p1proto, codeProto, p2proto, pieza, conclPieza, h1web, pWeb, tabla, conclTabla, h1SesionHTTP, p1Sesion, p2Sesion, figHTTP, conclHTTP, h1SessionScope, p1Session, codeSesion, figSesion, conclSesion, h1State, pState, dState, pRegla, h1Explorar, links])
intro = Text("El **scope** decide cuántas instancias crea Spring de cada bean y cuándo las crea. Un **bean** es un objeto que Spring crea y gestiona. Si no dices nada, el scope es **singleton**.")
h1sing = Heading("Singleton", 2)
p1sing = Text("El scope **singleton** hace que Spring cree **una sola instancia** del bean y la comparta con todo el que la pida. `@Service` y `@Component` ya son singleton.")
fSing = Figure("Una sola instancia compartida por varios componentes.", [instancia, a1sing, consumidores], "row")
instancia = Chip("Una instancia", "violet", "server")
a1sing = Arrow()
consumidores = Group([pedidoCtrl, pedidoServ, facturaServ], "row")
pedidoCtrl = Chip("PedidoController", "grey", "route")
pedidoServ = Chip("PedidoService", "grey", "code")
facturaServ = Chip("FacturaService", "grey", "code")
conclSing = Text("**Todos los componentes reciben la misma instancia.**")
warn = Callout("warning", "Como todos comparten la misma instancia, un bean singleton **no debe guardar estado de una petición en sus campos**. Si `PedidoService` guarda el usuario actual en un atributo, la siguiente petición lo pisa.")
codeSing = CodeBlock("@Service  // singleton: una instancia para toda la aplicación\npublic class PedidoService {\n    private PedidoRepository repo;   // bien: la dependencia no cambia\n    // private Usuario usuario;      // mal: lo compartirían todas las peticiones\n}", "java", "PedidoService.java")
h1proto = Heading("Prototype", 2)
p1proto = Text("El scope **prototype** hace que Spring cree **una instancia nueva cada vez** que se pide el bean. Sirve para objetos con estado propio que no quieres compartir.")
codeProto = CodeBlock("@Component\n@Scope(\"prototype\")\npublic class InformeBuilder { }", "java", "InformeBuilder.java")
p2proto = Text("Cada petición recibe una instancia distinta: `InformeBuilder A`, `InformeBuilder B`, `InformeBuilder C`.")
pieza = Artifact("Singleton vs prototype en la práctica", "Dos botones: 'Pedir singleton' y 'Pedir prototype'. Al pulsarlos se pide un bean con el scope indicado. Debajo de cada botón se muestra cuántas instancias distintas ha creado Spring: el contador singleton se queda en 1; el de prototype sube una unidad por clic.", 360, "<!doctype html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Singleton vs prototype en la práctica</title>\n<style>\n  html, body {\n    height: 100%;\n    margin: 0;\n    overflow: hidden;\n  }\n  *, *::before, *::after {\n    box-sizing: border-box;\n  }\n  body {\n    font-family: inherit;\n    color: var(--color-fg);\n    background: var(--color-bg);\n    padding: 16px;\n    -webkit-font-smoothing: antialiased;\n  }\n  .widget {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    height: 100%;\n    min-height: 0;\n  }\n  .title {\n    font-size: 1rem;\n    font-weight: 600;\n    margin: 0;\n    line-height: 1.3;\n    color: var(--color-fg);\n  }\n  .panels {\n    display: flex;\n    gap: 12px;\n    flex-wrap: wrap;\n    flex: 1;\n    min-height: 0;\n    align-items: flex-start;\n  }\n  .panel {\n    flex: 1 1 148px;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n  .btn {\n    appearance: none;\n    -webkit-appearance: none;\n    border: 1px solid var(--color-border);\n    background: var(--color-bg-subtle);\n    color: var(--color-fg);\n    font: inherit;\n    font-weight: 500;\n    padding: 10px 12px;\n    border-radius: var(--radius-md);\n    cursor: pointer;\n    white-space: nowrap;\n    transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;\n  }\n  .btn:hover {\n    background: var(--color-bg);\n    border-color: var(--color-accent);\n  }\n  .btn:active {\n    transform: scale(0.98);\n  }\n  .btn:focus-visible {\n    outline: 2px solid var(--color-accent);\n    outline-offset: 2px;\n  }\n  .diagram-chip {\n    display: inline-flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 8px;\n    padding: 8px 10px;\n    border-radius: var(--radius-md);\n    background: color-mix(in srgb, var(--diagram-color) 14%, var(--color-bg));\n    color: var(--diagram-color);\n    font-size: 0.85rem;\n    font-weight: 600;\n    line-height: 1.2;\n  }\n  .chip-label {\n    opacity: 0.7;\n    font-weight: 500;\n  }\n  .chip-count {\n    font-variant-numeric: tabular-nums;\n    font-weight: 700;\n  }\n</style>\n</head>\n<body>\n  <div class=\"widget\">\n    <h1 class=\"title\">Singleton vs prototype en la práctica</h1>\n    <div class=\"panels\">\n      <section class=\"panel\" aria-label=\"Alcance singleton\">\n        <button class=\"btn\" id=\"btn-singleton\" type=\"button\">Pedir singleton</button>\n        <div class=\"diagram-chip\" id=\"chip-singleton\" style=\"--diagram-color: #2563eb\" aria-live=\"polite\">\n          <span class=\"chip-label\">Instancias</span>\n          <span class=\"chip-count\" id=\"count-singleton\">0</span>\n        </div>\n      </section>\n      <section class=\"panel\" aria-label=\"Alcance prototype\">\n        <button class=\"btn\" id=\"btn-prototype\" type=\"button\">Pedir prototype</button>\n        <div class=\"diagram-chip\" id=\"chip-prototype\" style=\"--diagram-color: #7c3aed\" aria-live=\"polite\">\n          <span class=\"chip-label\">Instancias</span>\n          <span class=\"chip-count\" id=\"count-prototype\">0</span>\n        </div>\n      </section>\n    </div>\n  </div>\n  <script>\n    (function() {\n      var btnSingleton = document.getElementById('btn-singleton');\n      var btnPrototype = document.getElementById('btn-prototype');\n      var countSingleton = document.getElementById('count-singleton');\n      var countPrototype = document.getElementById('count-prototype');\n      var singletonCount = 0;\n      var prototypeCount = 0;\n\n      function renderSingleton() {\n        countSingleton.textContent = singletonCount;\n      }\n      function renderPrototype() {\n        countPrototype.textContent = prototypeCount;\n      }\n\n      btnSingleton.addEventListener('click', function() {\n        // Un bean singleton siempre es la misma instancia.\n        singletonCount = 1;\n        renderSingleton();\n      });\n\n      btnPrototype.addEventListener('click', function() {\n        // Un bean prototype crea una instancia nueva en cada petición.\n        prototypeCount += 1;\n        renderPrototype();\n      });\n    })();\n  </script>\n</body>\n</html>")
conclPieza = Text("**Con singleton se reutiliza la misma instancia; con prototype se crea una nueva en cada petición.**")
h1web = Heading("Scopes web", 2)
pWeb = Text("En una aplicación web hay más scopes, ligados a la petición y a la sesión:")
tabla = Table(["Scope", "Una instancia por...", "Cuándo usarlo"], [["`singleton`", "aplicación", "por defecto"], ["`prototype`", "cada vez que se pide", "objetos con estado propio"], ["`request`", "petición HTTP", "datos que solo viven durante una petición"], ["`session`", "sesión de usuario", "datos del usuario entre peticiones (carrito, login)"], ["`application`", "aplicación web", "igual que singleton, pero solo en web"]])
conclTabla = Text("**Cuanto más estrecho es el scope, más corta es la vida de la instancia.**")
h1SesionHTTP = Heading("Sesión HTTP", 2)
p1Sesion = Text("Una **sesión HTTP** es la forma de que el servidor se acuerde de quién eres entre peticiones. HTTP, por sí solo, no recuerda nada: cada petición llega sola.")
p2Sesion = Text("Al empezar, el servidor crea una sesión con un identificador y se lo manda al navegador en una cookie (`JSESSIONID`). En cada petición siguiente el navegador manda la cookie y el servidor localiza la sesión.")
figHTTP = Figure("La cookie JSESSIONID enlaza al navegador con su sesión en el servidor.", [navegador, aHTTP, servidor], "row")
navegador = Chip("Navegador", "blue", "globe", "guarda JSESSIONID=abc123")
aHTTP = Arrow("cookie JSESSIONID")
servidor = Area("Servidor", [sesionLabel, usuarioLabel], "cyan", "server", null, "column")
sesionLabel = Label("Sesión abc123", "key")
usuarioLabel = Label("usuario: ana", "user")
conclHTTP = Text("**El navegador devuelve la cookie en cada petición y el servidor recupera la sesión.**")
h1SessionScope = Heading("Session scope", 2)
p1Session = Text("El scope **session** hace que cada usuario tenga su propia instancia del bean y se reutilice mientras dura su sesión. Solo existe en aplicaciones web.")
codeSesion = CodeBlock("@Component\n@SessionScope\npublic class CarritoCompra { }", "java", "CarritoCompra.java")
figSesion = Figure("Cada sesión recibe su propia instancia de CarritoCompra.", [gAna, gJose], "column")
gAna = Group([ana, aAna, carritoAna], "row")
ana = Chip("Sesión de Ana", "pink", "user")
aAna = Arrow()
carritoAna = Chip("CarritoCompra A", "pink", "package")
gJose = Group([jose, aJose, carritoJose], "row")
jose = Chip("Sesión de Jose", "pink", "user")
aJose = Arrow()
carritoJose = Chip("CarritoCompra B", "pink", "package")
conclSesion = Text("**Ana y Jose no comparten el carrito: cada sesión mantiene su propia instancia.**")
h1State = Heading("Stateful y stateless", 2)
pState = Text("Estos dos términos describen si la aplicación recuerda información entre peticiones.")
dState = DescriptionList([dStateless, dStateful])
dStateless = DescriptionItem("Stateless", "Cada petición lleva todo lo que necesita y el servidor no guarda nada del usuario. Ejemplo: una API con un token en cada llamada.")
dStateful = DescriptionItem("Stateful", "El servidor guarda información del usuario entre peticiones. Una sesión HTTP es stateful.")
pRegla = Text("La regla práctica con Spring: **los beans singleton son stateless** (compartidos, sin datos de petición en campos), y el estado de cada usuario vive en un bean de scope `request` o `session`.")
h1Explorar = Heading("Para explorar", 2)
links = Text("- [Bean scopes en la documentación de Spring](https://docs.spring.io/spring-framework/reference/core/beans/factory-scopes.html)\n- [Web scopes y el proxy de sesión](https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-servlet/container-config.html)")
