root = Page([intro, h1, p1, code1, h2, p2, code2, p2b, h3, p3, code3, h4, p4, code4, h5, p5, code5, h6, p6, table1, p6b, code6, warn, code7, h7, p7, code9, h8, p8, table2, p8b, p8c, fig, p8d, h9, p9, tree, explore, links])
intro = Text("Cuando el navegador pide una URL como `http://localhost:8080/products/`, el servidor tiene que decidir qué responder. De eso se encarga el **controlador**: recibe la **petición HTTP** y la lleva al método que toca.")
h1 = Heading("Controlador", 2)
p1 = Text("Un **controlador** es la clase que recibe las peticiones HTTP del cliente y decide qué hacer con ellas. Se marca con `@Controller`, y Spring lo crea como un bean.")
code1 = CodeBlock("@Controller\npublic class HomeController { }", "java", "HomeController.java")
h2 = Heading("Rutas", 2)
p2 = Text("Una **ruta** es la dirección que atiende un método. `@GetMapping` asocia una ruta a un método para las peticiones GET, las de abrir una página.")
code2 = CodeBlock("@Controller\npublic class HomeController {\n\n    @GetMapping(\"/\")\n    public String index() {\n        return \"index\";   // templates/index.html\n    }\n}", "java", "HomeController.java")
p2b = Text("**El método devuelve el nombre de la vista**, y su archivo sale de `templates/`.")
h3 = Heading("Varias direcciones en una ruta", 3)
p3 = Text("Dentro de la anotación caben varias direcciones entre llaves, separadas por comas. La misma vista responde en las tres.")
code3 = CodeBlock("@GetMapping({\"/\", \"/home\", \"\"})", "java")
h4 = Heading("Prefijo con @RequestMapping", 3)
p4 = Text("`@RequestMapping` sobre la clase añade un prefijo a todas sus rutas. Agrupa y diferencia las rutas de una parte de la aplicación.")
code4 = CodeBlock("@Controller\n@RequestMapping(\"/products\")\npublic class ProductController {\n\n    @GetMapping(\"/\")             // /products/\n    public String showView() { ... }\n\n    @GetMapping(\"/electronics\")  // /products/electronics\n    public String showElectronics() { ... }\n}", "java", "ProductController.java")
h5 = Heading("Variable en la ruta", 3)
p5 = Text("`@PathVariable` coge un trozo variable de la URL y lo pasa como parámetro. Ese trozo se escribe entre llaves.")
code5 = CodeBlock("@GetMapping(\"/products/{id}\")\npublic String showProduct(@PathVariable Long id) { ... }", "java")
h6 = Heading("Parámetro en la query", 3)
p6 = Text("Un trozo de la ruta va con `@PathVariable`; lo que va después del `?` va con `@RequestParam`.")
table1 = Table(["Se escribe", "Se lee con", "Ejemplo"], [["en la ruta: `/products/{id}`", "`@PathVariable`", "`/products/5`"], ["tras el `?`: `?category=libros`", "`@RequestParam`", "`/products?category=libros`"]])
p6b = Text("**Con `/products?category=libros`, `category` vale `libros`.**")
code6 = CodeBlock("@GetMapping(\"/products\")\npublic String list(@RequestParam String category, Model model) { ... }", "java")
warn = Callout("warning", "Si el parámetro puede no venir, no lo dejes obligatorio: el método responde con un 400.")
code7 = CodeBlock("@RequestParam(required = false, defaultValue = \"todos\") String category\n\n@RequestParam Optional<String> category   // category.orElse(\"todos\")", "java")
h7 = Heading("Pasar datos a la vista", 2)
p7 = Text("El controlador entrega datos a la plantilla con un objeto `Model`. Cada dato lleva un nombre con el que la plantilla lo usa después.")
code9 = CodeBlock("@GetMapping(\"/saludo\")\npublic String saludo(Model model) {\n    model.addAttribute(\"nombre\", \"Ana\");\n    return \"saludo\";\n}", "java", "HomeController.java")
h8 = Heading("Con vista o sin vista", 2)
p8 = Text("Según lo que devuelva el método, hay dos tipos de controlador:")
table2 = Table(["Anotación", "Devuelve", "Para"], [["`@Controller`", "el nombre de una vista", "una página HTML (MVC)"], ["`@RestController`", "datos, normalmente en JSON", "una API"]])
p8b = Text("**En MVC hay vista; en una API el cliente recibe los datos y los pinta él.**")
p8c = Text("Sigue una petición desde el cliente hasta su respuesta:")
fig = Figure("Una petición del cliente llega al controlador, que encuentra el método de esa ruta y responde con una vista HTML o con datos JSON.", [client, a1, controller, a2, out])
client = Area("Cliente", [nav, post], "blue", "globe", "Pide una URL (GET).", "row")
nav = Chip("Navegador")
post = Chip("Postman")
a1 = Arrow()
controller = Area("Controlador", [m1], "violet", "route", "Encuentra el método de esa ruta.")
m1 = Chip("@GetMapping(\"/products\")")
a2 = Arrow()
out = Group([view, data], "column")
view = Area("Vista (HTML)", [], "cyan", "file-code", "@Controller")
data = Area("Datos (JSON)", [], "pink", "braces", "@RestController")
p8d = Text("**La misma petición termina en una vista HTML o en datos JSON, según el controlador.**")
h9 = Heading("Archivos estáticos", 2)
p9 = Text("Las imágenes, el CSS y el JavaScript que no pasan por Thymeleaf van en `static/`.")
tree = CodeBlock("src/main/resources/\n├── templates/   vistas Thymeleaf\n└── static/      imágenes, CSS y JavaScript", "text", "src/main/resources")
explore = Heading("Para explorar", 2)
links = Text("- [Mapping Requests](https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-requestmapping.html), en la documentación de Spring.\n- [Annotated Controllers](https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann.html), cómo se declara un controlador.")
