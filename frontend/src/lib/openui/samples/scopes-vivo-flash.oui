root = Page([intro, hSingle, pSingle, codeSingle, figSingle, singleEnd, warn, hProto, pProto, codeProto, hArt, pArtBefore, artifact, artEnd, hWeb, pWeb, table, webEnd, hSesion, pSesion, figSesion, sesionEnd, hScopeSession, pScopeSession, codeScope, figScopeSession, scopeEnd, hState, dl, pRule, hExplore, links])
intro = Text("Un **scope** es la regla que decide cuándo Spring crea una instancia de un bean y cuánto la reutiliza. Si no dices nada, el scope es `singleton`.")
hSingle = Heading("Singleton")
pSingle = Text("**Singleton** crea **una sola instancia** del bean y la comparte entre todos los que la piden. `@Service` y `@Component` ya son singleton.")
codeSingle = CodeBlock("@Service  // singleton: una instancia para toda la aplicación\npublic class PedidoService {\n    private PedidoRepository repo;   // bien: la dependencia no cambia\n    // private Usuario usuario;      // mal: lo compartirían todas las peticiones\n}", "java", "PedidoService.java")
figSingle = Figure("Una única instancia del bean compartida por todos los que la piden.", [inst, arrSingle, consumidores])
inst = Chip("Una instancia", "violet", "package")
arrSingle = Arrow()
consumidores = Group([c1, c2, c3], "column")
c1 = Chip("PedidoController", "grey")
c2 = Chip("PedidoService", "grey")
c3 = Chip("FacturaService", "grey")
singleEnd = Text("**Una única instancia para toda la aplicación.**")
warn = Callout("warning", "Como todos comparten la misma instancia, un bean singleton **no debe guardar en sus campos datos de una petición**. Si `PedidoService` guarda el usuario actual en un atributo, la siguiente petición lo pisa.")
hProto = Heading("Prototype")
pProto = Text("**Prototype** crea **una instancia nueva cada vez** que se pide el bean. Sirve para objetos con estado propio que no quieres compartir.")
codeProto = CodeBlock("@Component\n@Scope(\"prototype\")\npublic class InformeBuilder { }", "java", "InformeBuilder.java")
hArt = Heading("Un ejemplo")
pArtBefore = Text("El mismo bean pedido varias veces, una vez por scope. Pulsa los botones y mira cuántas instancias salen:")
artifact = Artifact("Contador de instancias por scope", "Dos columnas, una por scope. Columna izquierda, en violeta, titulada «Singleton»: un botón «Pedir el bean» y debajo el número de instancias creadas y la lista de identificadores devueltos. Columna derecha, en cian, titulada «Prototype»: el mismo botón y los mismos datos. Al pulsar en la columna singleton se pide el bean y devuelve siempre la misma instancia, así que el contador se queda en 1 y la lista repite el identificador. Al pulsar en la columna prototype, cada pulsación crea una instancia nueva, el contador sube y la lista crece con identificadores distintos. Lo que hay que notar: con singleton el número no sube; con prototype sube con cada pulsación.", 320, "<!doctype html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Contador de instancias por scope</title>\n<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  html, body { height: 100%; }\n  body {\n    margin: 0;\n    padding: 16px;\n    background: var(--color-bg);\n    color: var(--color-fg);\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n  }\n  .grid {\n    flex: 1 1 auto;\n    min-height: 0;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 12px;\n  }\n  .col {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    min-height: 0;\n    min-width: 0;\n  }\n  .head { flex: 0 0 auto; }\n  .head h2 {\n    margin: 0;\n    font-size: clamp(13px, 3.6vw, 16px);\n    font-weight: 600;\n    letter-spacing: .01em;\n    color: var(--diagram-color);\n  }\n  .head p {\n    margin: 3px 0 0;\n    font-size: clamp(9px, 2.4vw, 11.5px);\n    line-height: 1.2;\n    color: var(--color-fg-secondary);\n  }\n  .pedir {\n    flex: 0 0 auto;\n    width: 100%;\n    font-size: clamp(11px, 2.9vw, 13px);\n    cursor: pointer;\n  }\n  .pedir:active { transform: translateY(1px); }\n  .stat {\n    flex: 0 0 auto;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    min-width: 0;\n  }\n  .num {\n    display: inline-block;\n    font-family: var(--font-mono);\n    font-size: clamp(20px, 6.4vw, 30px);\n    font-weight: 600;\n    line-height: 1;\n    color: var(--diagram-color);\n    font-variant-numeric: tabular-nums;\n  }\n  .num.sube { animation: sube .32s ease; }\n  @keyframes sube {\n    0% { transform: scale(1); }\n    45% { transform: scale(1.22); }\n    100% { transform: scale(1); }\n  }\n  .meta {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n    min-width: 0;\n  }\n  .meta .lbl {\n    font-size: clamp(9px, 2.4vw, 11.5px);\n    line-height: 1.1;\n    color: var(--color-fg);\n  }\n  .meta .pet {\n    font-size: clamp(9px, 2.2vw, 11px);\n    line-height: 1.1;\n    color: var(--color-fg-muted);\n  }\n  .meta .pet b {\n    font-family: var(--font-mono);\n    font-weight: 600;\n    color: var(--color-fg-secondary);\n  }\n  .list-head {\n    flex: 0 0 auto;\n    font-size: clamp(8.5px, 2.2vw, 10.5px);\n    letter-spacing: .07em;\n    text-transform: uppercase;\n    color: var(--color-fg-muted);\n  }\n  .list {\n    flex: 1 1 auto;\n    min-height: 0;\n    overflow: hidden;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n  }\n  .list li {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    min-width: 0;\n    line-height: 1.25;\n  }\n  .list .idx {\n    flex: 0 0 auto;\n    min-width: 1.5em;\n    text-align: right;\n    font-family: var(--font-mono);\n    font-size: clamp(8.5px, 2.2vw, 10.5px);\n    color: var(--color-fg-muted);\n  }\n  .list .code {\n    min-width: 0;\n    font-family: var(--font-mono);\n    font-size: clamp(10px, 2.7vw, 12.5px);\n    color: var(--color-fg);\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .list li.nueva { animation: entra .3s ease; }\n  @keyframes entra {\n    from { opacity: 0; transform: translateY(-5px); }\n    to { opacity: 1; transform: none; }\n  }\n</style>\n</head>\n<body>\n  <div class=\"grid\">\n    <section class=\"col diagram-area\" style=\"--diagram-color: #7c3aed\">\n      <div class=\"head\">\n        <h2>Singleton</h2>\n        <p>Siempre la misma instancia</p>\n      </div>\n      <button class=\"pedir\" type=\"button\" data-scope=\"singleton\">Pedir el bean</button>\n      <div class=\"stat\">\n        <span class=\"num\" id=\"n-singleton\">1</span>\n        <span class=\"meta\">\n          <span class=\"lbl\">instancias creadas</span>\n          <span class=\"pet\">peticiones: <b id=\"p-singleton\">1</b></span>\n        </span>\n      </div>\n      <div class=\"list-head\">devueltos</div>\n      <ul class=\"list\" id=\"l-singleton\"></ul>\n    </section>\n\n    <section class=\"col diagram-area\" style=\"--diagram-color: #0891b2\">\n      <div class=\"head\">\n        <h2>Prototype</h2>\n        <p>Una instancia nueva cada vez</p>\n      </div>\n      <button class=\"pedir\" type=\"button\" data-scope=\"prototype\">Pedir el bean</button>\n      <div class=\"stat\">\n        <span class=\"num\" id=\"n-prototype\">1</span>\n        <span class=\"meta\">\n          <span class=\"lbl\">instancias creadas</span>\n          <span class=\"pet\">peticiones: <b id=\"p-prototype\">1</b></span>\n        </span>\n      </div>\n      <div class=\"list-head\">devueltos</div>\n      <ul class=\"list\" id=\"l-prototype\"></ul>\n    </section>\n  </div>\n\n<script>\n(function () {\n  var MAX = 5;\n  var usados = Object.create(null);\n\n  function nuevoId() {\n    var id;\n    do {\n      id = Math.floor(Math.random() * 65536).toString(16);\n      while (id.length < 4) id = '0' + id;\n    } while (usados[id]);\n    usados[id] = true;\n    return id;\n  }\n\n  var estado = {\n    singleton: { instancias: 1, peticiones: 1, fijo: nuevoId(), ids: [] },\n    prototype: { instancias: 1, peticiones: 1, ids: [] }\n  };\n  estado.singleton.ids.push(estado.singleton.fijo);\n  estado.prototype.ids.push(nuevoId());\n\n  function pintar(clave) {\n    var e = estado[clave];\n    document.getElementById('n-' + clave).textContent = e.instancias;\n    document.getElementById('p-' + clave).textContent = e.peticiones;\n\n    var lista = document.getElementById('l-' + clave);\n    var filas = [];\n    var desde = Math.max(0, e.ids.length - MAX);\n    for (var i = e.ids.length - 1; i >= desde; i--) {\n      var li = document.createElement('li');\n      if (i === e.ids.length - 1) li.className = 'nueva';\n\n      var idx = document.createElement('span');\n      idx.className = 'idx';\n      idx.textContent = e.ids.length - i;\n\n      var code = document.createElement('span');\n      code.className = 'code';\n      code.textContent = 'bean#' + e.ids[i];\n\n      li.appendChild(idx);\n      li.appendChild(code);\n      filas.push(li);\n    }\n    lista.replaceChildren.apply(lista, filas);\n  }\n\n  function pedir(clave) {\n    var e = estado[clave];\n    e.peticiones++;\n\n    if (clave === 'singleton') {\n      e.ids.push(e.fijo);\n    } else {\n      e.instancias++;\n      e.ids.push(nuevoId());\n      var num = document.getElementById('n-' + clave);\n      num.classList.remove('sube');\n      void num.offsetWidth;\n      num.classList.add('sube');\n    }\n    pintar(clave);\n  }\n\n  var botones = document.querySelectorAll('.pedir');\n  for (var i = 0; i < botones.length; i++) {\n    botones[i].addEventListener('click', function () {\n      pedir(this.getAttribute('data-scope'));\n    });\n  }\n\n  pintar('singleton');\n  pintar('prototype');\n})();\n</script>\n</body>\n</html>")
artEnd = Text("**El contador no sube con singleton y sube con cada pulsación en prototype.**")
hWeb = Heading("Scopes web")
pWeb = Text("En una aplicación web hay más scopes, ligados a la petición y a la sesión:")
table = Table(["Scope", "Una instancia por…", "Cuándo usarlo"], [["`singleton`", "aplicación", "por defecto"], ["`prototype`", "cada vez que se pide", "objetos con estado propio"], ["`request`", "petición HTTP", "datos que solo viven durante una petición"], ["`session`", "sesión de usuario", "datos del usuario entre peticiones (carrito, login)"], ["`application`", "aplicación web", "igual que singleton, pero solo en web"]])
webEnd = Text("**Cuanto más corto el scope, menos vive la instancia.**")
hSesion = Heading("Sesión HTTP")
pSesion = Text("Una **sesión HTTP** es la forma de que el servidor se acuerde de quién eres entre peticiones. HTTP no recuerda nada: cada petición llega sola, sin saber de las anteriores. Un `POST /login`, un `GET /perfil` y un `GET /carrito` del mismo usuario llegan sueltos.")
figSesion = Figure("Al empezar, el servidor crea una sesión con un identificador; el navegador lo manda en una cookie y el servidor localiza la sesión.", [navegador, arrSesion, servidor])
navegador = Chip("Navegador", "blue", "globe")
arrSesion = Arrow("JSESSIONID=abc123")
servidor = Area("Servidor", [sesionLabel], "grey", "server")
sesionLabel = Label("Sesión abc123: usuario Ana", "user", "violet")
sesionEnd = Text("**El identificador de la cookie es lo que el servidor usa para encontrar la sesión de cada petición.**")
hScopeSession = Heading("Session scope")
pScopeSession = Text("El scope **session** da a cada usuario su propia instancia del bean y la reutiliza mientras dura su sesión. Solo existe en aplicaciones web: en una de consola no hay sesión.")
codeScope = CodeBlock("@Component\n@SessionScope\npublic class CarritoCompra { }", "java", "CarritoCompra.java")
figScopeSession = Figure("Cada sesión tiene su propia instancia de CarritoCompra.", [sAna, sJose], "column")
sAna = Chip("Sesión de Ana → CarritoCompra A", "pink", "user")
sJose = Chip("Sesión de Jose → CarritoCompra B", "pink", "user")
scopeEnd = Text("**El mismo bean, una instancia distinta por usuario.**")
hState = Heading("Stateful y stateless")
dl = DescriptionList([d1, d2])
d1 = DescriptionItem("Stateless", "Cada petición lleva todo lo que necesita y el servidor no guarda nada del usuario. Ejemplo: una API con un token en cada llamada.")
d2 = DescriptionItem("Stateful", "El servidor guarda información del usuario entre peticiones. Una sesión HTTP es stateful.")
pRule = Text("La regla práctica con Spring: **los beans singleton son stateless**, sin datos de petición en sus campos, y el estado de cada usuario vive en un bean de scope `request` o `session`.")
hExplore = Heading("Para explorar")
links = Text("- [Bean scopes en la documentación de Spring](https://docs.spring.io/spring-framework/reference/core/beans/factory-scopes.html)\n- [Web scopes y el proxy de sesión](https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-servlet/container-config.html)")
