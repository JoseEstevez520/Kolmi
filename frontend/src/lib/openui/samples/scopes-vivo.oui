root = Page([intro, hSingleton, pSingleton, figSingleton, pSingleton2, warnSingleton, codeSingleton, hPrototype, pPrototype, codePrototype, pPrototype2, codePrototype2, tipPrototype, artifactInstancias, cierreInstancias, hWeb, pWeb, tablaScopes, cierreTabla, hSesion, pSesion, codePeticiones, pSesion2, codeCookie, hSessionScope, pSessionScope, codeSesiones, pSessionScope2, codeSessionScope, pSessionScope3, hEstado, pEstado, listaEstado, pEstado2, hExplorar, links])
intro = Text("El **scope** es la regla que decide cuántas instancias de un bean crea Spring y cuánto las reutiliza. Un **bean** es un objeto que Spring crea y gestiona. Si no se indica nada, el scope es `singleton`.")
hSingleton = Heading("Singleton")
pSingleton = Text("Spring crea una sola instancia del bean y se la da a todos los que la pidan.")
figSingleton = CodeBlock("                    ┌→ PedidoController\nUna instancia ──────┼→ PedidoService\n                    └→ FacturaService", "text")
pSingleton2 = Text("Es el scope por defecto: `@Service` y `@Component` ya son singleton.")
warnSingleton = Callout("warning", "Todos comparten la misma instancia, así que un singleton no debe guardar datos de una petición en sus campos: la siguiente petición los pisa.")
codeSingleton = CodeBlock("@Service  // singleton: una instancia para toda la aplicación\npublic class PedidoService {\n    private PedidoRepository repo;   // bien: la dependencia no cambia\n    // private Usuario usuario;      // mal: lo compartirían todas las peticiones\n}", "java")
hPrototype = Heading("Prototype")
pPrototype = Text("Spring crea una instancia nueva cada vez que se pide el bean. Sirve para objetos con estado propio que no quieres compartir.")
codePrototype = CodeBlock("@Component\n@Scope(\"prototype\")\npublic class InformeBuilder { }", "java")
pPrototype2 = Text("Cada petición recibe la suya:")
codePrototype2 = CodeBlock("Petición → InformeBuilder A\nPetición → InformeBuilder B\nPetición → InformeBuilder C", "text")
tipPrototype = Callout("tip", "Para ver la diferencia, pide el bean varias veces en singleton y en prototype y cuenta cuántas instancias distintas salen.")
artifactInstancias = Artifact("Contar instancias en singleton y prototype", "Comparador interactivo, todo en español. Dos botones: «Pedir bean singleton» y «Pedir bean prototype». Cada clic pide el bean y añade a la lista de ese scope el identificador de la instancia recibida, por ejemplo `PedidoService@1a2b` o `InformeBuilder@3f9c`. La lista de singleton repite siempre el mismo identificador; la de prototype crece con uno nuevo en cada clic. Debajo de cada lista, un contador «instancias distintas: N». Lo que hay que notar: el mismo código pide el bean muchas veces y singleton devuelve siempre la misma instancia, prototype una nueva por petición.", 320, "<!doctype html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<style>\n  * { box-sizing: border-box; }\n  .top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }\n  .top p { margin: 0; font-size: 12.5px; color: var(--color-fg-secondary); }\n  .reset { background: none; color: var(--color-fg-secondary); font-size: 12px; padding: 4px 6px; }\n  .sides { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n  .side { display: flex; flex-direction: column; gap: 7px; min-width: 0; }\n  .side header { display: flex; flex-direction: column; gap: 1px; min-width: 0; }\n  .bean { font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .side small { font-size: 10.5px; color: var(--color-fg-muted); }\n  .desc { margin: 0; font-size: 11.5px; color: var(--color-fg-secondary); }\n  .side button { width: 100%; font-size: 11.5px; padding: 6px 6px; }\n  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 3px; min-width: 0; }\n  li.req { min-height: 20px; display: flex; align-items: center; padding: 1px 7px; font-family: var(--font-mono); font-size: clamp(9.5px, 1.3vw + 4.5px, 11.5px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  li.more { font-size: 10.5px; color: var(--color-fg-muted); padding-left: 2px; }\n  .count { margin: 0; font-size: 11.5px; color: var(--color-fg-secondary); }\n  .count strong { color: var(--color-fg); }\n  .footer { margin-top: 12px; display: flex; flex-direction: column; gap: 4px; }\n  .summary { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; color: var(--color-fg-secondary); }\n  .note { margin: 0; font-size: 11px; color: var(--color-fg-muted); }\n</style>\n</head>\n<body>\n<div class=\"top\">\n  <p>Pide el bean en cada lado y compara la instancia que devuelve cada scope.</p>\n  <button class=\"reset\" type=\"button\" id=\"reset\">Reiniciar</button>\n</div>\n\n<div class=\"sides\">\n  <section class=\"side\" style=\"--diagram-color: #2563eb\">\n    <header>\n      <span class=\"bean\">PedidoService</span>\n      <small>singleton · por defecto</small>\n    </header>\n    <p class=\"desc\">Una sola instancia compartida por todos.</p>\n    <button type=\"button\" id=\"ask-s\">Pedir bean singleton</button>\n    <ul id=\"list-s\"></ul>\n    <p class=\"count\" id=\"count-s\"></p>\n  </section>\n\n  <section class=\"side\" style=\"--diagram-color: #7c3aed\">\n    <header>\n      <span class=\"bean\">InformeBuilder</span>\n      <small>@Scope(\"prototype\")</small>\n    </header>\n    <p class=\"desc\">Una instancia nueva en cada petición.</p>\n    <button type=\"button\" id=\"ask-p\">Pedir bean prototype</button>\n    <ul id=\"list-p\"></ul>\n    <p class=\"count\" id=\"count-p\"></p>\n  </section>\n</div>\n\n<div class=\"footer\">\n  <p class=\"summary\">\n    <span id=\"sum-s\"></span>\n    <span id=\"sum-p\"></span>\n  </p>\n  <p class=\"note\">Un singleton se comparte: no debe guardar datos de una petición en sus campos.</p>\n</div>\n\n<script>\n  var scopes = {\n    s: { bean: 'PedidoService', inst: '', reqs: [] },\n    p: { bean: 'InformeBuilder', reqs: [] }\n  };\n  var MAX = 5;\n\n  function hex() { return Math.random().toString(16).slice(2, 6); }\n  function makeId(bean) { return bean + '@' + hex(); }\n  function plural(n) { return n === 1 ? 'instancia' : 'instancias'; }\n\n  function render() {\n    ['s', 'p'].forEach(function (k) {\n      var sc = scopes[k];\n      var total = sc.reqs.length;\n      var vis = sc.reqs.slice(-MAX);\n      var parts = [];\n      if (total > MAX) {\n        parts.push('<li class=\"more\">… y ' + (total - MAX) + ' peticiones anteriores</li>');\n      }\n      vis.forEach(function (id) {\n        parts.push('<li class=\"diagram-chip req\">' + id + '</li>');\n      });\n      document.getElementById('list-' + k).innerHTML = parts.join('');\n      document.getElementById('count-' + k).innerHTML =\n        'instancias distintas: <strong>' + new Set(sc.reqs).size + '</strong> · ' + total + ' peticiones';\n    });\n\n    var sn = scopes.s.reqs.length, sd = new Set(scopes.s.reqs).size;\n    var pn = scopes.p.reqs.length, pd = new Set(scopes.p.reqs).size;\n    document.getElementById('sum-s').textContent =\n      'Singleton: ' + sn + ' peticiones → ' + sd + ' ' + plural(sd);\n    document.getElementById('sum-p').textContent =\n      'Prototype: ' + pn + ' peticiones → ' + pd + ' ' + plural(pd);\n  }\n\n  function ask(k) {\n    var sc = scopes[k];\n    sc.reqs.push(k === 's' ? sc.inst : makeId(sc.bean));\n    render();\n  }\n\n  function reset() {\n    scopes.s.inst = makeId(scopes.s.bean);\n    scopes.s.reqs = [];\n    scopes.p.reqs = [];\n    for (var i = 0; i < 3; i++) {\n      scopes.s.reqs.push(scopes.s.inst);\n      scopes.p.reqs.push(makeId(scopes.p.bean));\n    }\n    render();\n  }\n\n  document.getElementById('ask-s').onclick = function () { ask('s'); };\n  document.getElementById('ask-p').onclick = function () { ask('p'); };\n  document.getElementById('reset').onclick = reset;\n\n  reset();\n</script>\n</body>\n</html>")
cierreInstancias = Text("**Con el mismo código, singleton da un solo identificador y prototype uno distinto en cada petición.**")
hWeb = Heading("Scopes web")
pWeb = Text("En una aplicación web hay más scopes, ligados a la petición y a la sesión.")
tablaScopes = Table(["Scope", "Una instancia por…", "Cuándo usarlo"], [["`singleton`", "aplicación", "por defecto"], ["`prototype`", "cada vez que se pide", "objetos con estado propio"], ["`request`", "petición HTTP", "datos que solo viven durante una petición"], ["`session`", "sesión de usuario", "datos del usuario entre peticiones (carrito, login)"], ["`application`", "aplicación web", "igual que singleton, pero solo en web"]])
cierreTabla = Text("**El scope decide cuánto vive la instancia: de toda la aplicación a una sola petición.**")
hSesion = Heading("Sesión HTTP")
pSesion = Text("Una **sesión HTTP** es la forma de que el servidor se acuerde de quién eres entre peticiones. HTTP por sí solo no recuerda nada: cada petición llega sin saber de las anteriores.")
codePeticiones = CodeBlock("Petición 1  POST /login\nPetición 2  GET  /perfil\nPetición 3  GET  /carrito", "text")
pSesion2 = Text("El servidor necesita saber que las tres son del mismo usuario. Al empezar, crea una sesión con un identificador y se lo manda al navegador en una cookie llamada `JSESSIONID`. El navegador la manda en cada petición siguiente y el servidor localiza la sesión.")
codeCookie = CodeBlock("Navegador ──JSESSIONID=abc123──→ Servidor\n                                   └── sesión abc123: { usuario: \"usuario1\" }", "text")
hSessionScope = Heading("Session scope")
pSessionScope = Text("El scope `session` da a cada usuario su propia instancia del bean y la reutiliza mientras dura su sesión.")
codeSesiones = CodeBlock("Sesión de usuario1 → CarritoCompra A\nSesión de usuario2 → CarritoCompra B", "text")
pSessionScope2 = Text("En Spring:")
codeSessionScope = CodeBlock("@Component\n@SessionScope\npublic class CarritoCompra { }", "java")
pSessionScope3 = Text("Solo existe en aplicaciones web; en una de consola no hay sesión.")
hEstado = Heading("Stateless y stateful")
pEstado = Text("Estos dos términos describen si la aplicación recuerda información entre peticiones.")
listaEstado = Text("- **Stateless:** cada petición lleva todo lo que necesita y el servidor no guarda nada del usuario. Ejemplo: una API con un token en cada llamada.\n- **Stateful:** el servidor guarda información del usuario entre peticiones. Una sesión HTTP es stateful.")
pEstado2 = Text("En Spring, los beans singleton son stateless: se comparten y no llevan datos de petición en sus campos. El estado de cada usuario vive en un bean de scope `request` o `session`.")
hExplorar = Heading("Para explorar")
links = Cards([cardScopes, cardWebScopes])
cardScopes = Card("Bean scopes en la documentación de Spring", null, "https://docs.spring.io/spring-framework/reference/core/beans/factory-scopes.html")
cardWebScopes = Card("Web scopes y el proxy de sesión", null, "https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-servlet/container-config.html")