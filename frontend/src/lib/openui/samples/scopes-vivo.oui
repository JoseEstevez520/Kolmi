root = Page([intro, hSingleton, tSingleton, figSingleton, pDefault, warn, codeSingleton, hProto, tProto, codeProto, figProto, pProtoUse, pToy, art, hHTTP, tHTTP, figPeticiones, tCookie, figSession, pCookieFin, hSS, tSS, figSS, codeSS, hComp, tWeb, tabla, hSt, tSt, dl, tRegla, hExp, tExplore])
intro = Text("Cada bean tiene un **scope**, que decide cuántas instancias crea Spring y cuánto las reutiliza. Un **bean** es un objeto que Spring crea y gestiona. El scope por defecto es `singleton`.")
hSingleton = Heading("Singleton")
tSingleton = Text("Spring crea **una sola instancia** del bean y se la pasa a todo el que la pida:")
figSingleton = Figure("Una única instancia del bean, repartida entre todos los que la piden.", [inst, a1, destinos])
inst = Chip("Una instancia", "blue", "package", "la misma para todos")
a1 = Arrow()
destinos = Group([d1, d2, d3], "column")
d1 = Chip("PedidoController")
d2 = Chip("PedidoService")
d3 = Chip("FacturaService")
pDefault = Text("Es el scope por defecto: `@Service` y `@Component` ya son singleton. **Una sola instancia, compartida por toda la aplicación.**")
warn = Callout("warning", "Como todos comparten la misma instancia, un bean singleton **no debe guardar datos de una petición en sus campos**. Si `PedidoService` guarda el usuario actual en un atributo, la siguiente petición lo pisa.")
codeSingleton = CodeBlock("@Service  // singleton: una instancia para toda la aplicación\npublic class PedidoService {\n    private PedidoRepository repo;   // bien: la dependencia no cambia\n    // private Usuario usuario;      // mal: lo compartirían todas las peticiones\n}", "java", "PedidoService.java")
hProto = Heading("Prototype")
tProto = Text("Spring crea **una instancia nueva cada vez** que alguien pide el bean:")
codeProto = CodeBlock("@Component\n@Scope(\"prototype\")\npublic class InformeBuilder { }", "java", "InformeBuilder.java")
figProto = Figure("Cada petición al bean recibe una instancia nueva, que no se comparte con nadie.", [peticiones, a2, nuevos])
peticiones = Chip("Peticiones", "grey", "send")
a2 = Arrow()
nuevos = Group([i1, i2, i3], "column")
i1 = Chip("InformeBuilder A", "violet")
i2 = Chip("InformeBuilder B", "violet")
i3 = Chip("InformeBuilder C", "violet")
pProtoUse = Text("Sirve para objetos con estado propio que no quieres compartir. **Una instancia nueva por petición.**")
pToy = Text("Para ver la diferencia, pide el bean varias veces en singleton y en prototype y cuenta cuántas instancias distintas salen:")
art = Artifact("¿Cuántas instancias salen?", "Dos paneles comparables, uno al lado del otro: «singleton» en azul y «prototype» en violeta. Cada panel lleva un botón «Pedir el bean» y un contador de instancias distintas creadas. Al pulsar, se añade una línea «Petición n → PedidoService@x»: en singleton todas las líneas apuntan a la misma instancia (@1), el contador se queda en 1 y aparece el aviso «misma instancia»; en prototype cada línea recibe una instancia nueva (@1, @2, @3…) y el contador sube, con el aviso «instancia nueva». Un botón «Reiniciar» vuelve a cero en los dos paneles. Lo que hay que notar: en singleton el número de instancias distintas no pasa de 1 por muchas veces que se pida el bean; en prototype crece con cada petición. Todo el texto de la pieza en español.", 320, "<template>\n  <div class=\"flex flex-col gap-4\">\n    <p class=\"m-0 text-ui text-fg-secondary\">\n      El scope decide cuántas instancias crea Spring. Pide el bean en los dos paneles y cuenta cuántas instancias distintas salen.\n    </p>\n\n    <div class=\"grid grid-cols-1 gap-4 sm:grid-cols-2\">\n      <Card v-for=\"panel in paneles\" :key=\"panel.id\">\n        <CardHeader>\n          <div class=\"flex flex-wrap items-center gap-2\">\n            <DiagramChip :color=\"panel.color\">{{ panel.scope }}</DiagramChip>\n            <span class=\"text-label text-fg\">{{ panel.bean }}</span>\n            <Badge v-if=\"panel.porDefecto\">por defecto</Badge>\n          </div>\n          <CardDescription>{{ panel.descripcion }}</CardDescription>\n        </CardHeader>\n        <CardContent class=\"flex flex-col gap-3\">\n          <div class=\"flex flex-wrap items-center justify-between gap-2\">\n            <Button @click=\"pedir(panel.id)\">Pedir el bean</Button>\n            <span class=\"flex items-baseline gap-2\">\n              <span class=\"text-meta text-fg-muted\">Instancias distintas</span>\n              <TextMorph class=\"text-ui text-fg tabular-nums\" :text=\"String(panel.instancias)\" />\n            </span>\n          </div>\n          <Separator />\n          <p v-if=\"!panel.lineas.length\" class=\"m-0 text-meta text-fg-muted\">\n            Todavía no se ha pedido el bean.\n          </p>\n          <div v-else class=\"flex flex-col gap-1\">\n            <span\n              v-for=\"linea in panel.lineas\"\n              :key=\"linea.n\"\n              class=\"text-meta tabular-nums text-fg-secondary\"\n            >Petición {{ linea.n }} → {{ panel.bean }}@{{ linea.instancia }}</span>\n          </div>\n          <Callout v-if=\"panel.lineas.length\">{{ panel.aviso }}</Callout>\n        </CardContent>\n      </Card>\n    </div>\n\n    <div class=\"flex flex-wrap items-center gap-3\">\n      <Button variant=\"ghost\" :disabled=\"totalPeticiones === 0\" @click=\"reiniciar\">Reiniciar</Button>\n      <span class=\"text-meta text-fg-muted\">Vuelve a cero en los dos paneles.</span>\n    </div>\n\n    <Callout>\n      En singleton el número de instancias distintas no pasa de 1 por muchas veces que se pida el bean; en prototype crece con cada petición.\n    </Callout>\n  </div>\n</template>\n\n<script>\nimport { computed, reactive } from 'vue'\n\nexport default {\n  setup() {\n    const peticiones = reactive({ singleton: 0, prototype: 0 })\n\n    const paneles = computed(() => [\n      {\n        id: 'singleton',\n        scope: 'singleton',\n        color: '#2563eb',\n        bean: 'PedidoService',\n        porDefecto: true,\n        descripcion: 'Es el scope por defecto: @Service y @Component ya son singleton. Spring crea una sola instancia y se la pasa a todo el que la pida.',\n        instancias: peticiones.singleton > 0 ? 1 : 0,\n        aviso: 'misma instancia: PedidoService@1 responde a todas las peticiones.',\n        lineas: Array.from({ length: peticiones.singleton }, (_, i) => ({ n: i + 1, instancia: 1 })),\n      },\n      {\n        id: 'prototype',\n        scope: 'prototype',\n        color: '#7c3aed',\n        bean: 'InformeBuilder',\n        porDefecto: false,\n        descripcion: 'Con @Scope(\"prototype\") Spring crea una instancia nueva cada vez que alguien pide el bean: para objetos con estado propio que no quieres compartir.',\n        instancias: peticiones.prototype,\n        aviso: 'instancia nueva: cada petición recibe su propio InformeBuilder.',\n        lineas: Array.from({ length: peticiones.prototype }, (_, i) => ({ n: i + 1, instancia: i + 1 })),\n      },\n    ])\n\n    const totalPeticiones = computed(() => peticiones.singleton + peticiones.prototype)\n\n    function pedir(id) {\n      peticiones[id] += 1\n    }\n\n    function reiniciar() {\n      peticiones.singleton = 0\n      peticiones.prototype = 0\n    }\n\n    return { paneles, totalPeticiones, pedir, reiniciar }\n  },\n}\n</script>")
hHTTP = Heading("Sesión HTTP")
tHTTP = Text("HTTP es el protocolo con el que el navegador pide cada recurso al servidor, y no recuerda nada entre peticiones: cada una llega sola, sin saber de las anteriores.")
figPeticiones = Figure("Tres peticiones seguidas: ninguna sabe de las anteriores.", [q1, q2, q3], "column")
q1 = Chip("Petición 1 · POST /login", "grey")
q2 = Chip("Petición 2 · GET /perfil", "grey")
q3 = Chip("Petición 3 · GET /carrito", "grey")
tCookie = Text("Para atender `/perfil` y `/carrito` hay que saber que son del mismo usuario que hizo el login. De eso se encarga la **sesión HTTP**: al empezar, el servidor crea una sesión con un identificador y se lo manda al navegador en una **cookie**, un dato que el navegador guarda y devuelve en cada petición. La cookie se llama `JSESSIONID`, y con ella el servidor localiza la sesión.")
figSession = Figure("El navegador manda la cookie en cada petición y el servidor encuentra con ella la sesión del usuario.", [nav, a3, servidor])
nav = Chip("Navegador", "grey", "globe")
a3 = Arrow("JSESSIONID=abc123")
servidor = Area("Servidor", [l1], "cyan", "server", "Localiza la sesión por su identificador.")
l1 = Label("sesión abc123 · usuario \"ana\"")
pCookieFin = Text("**La cookie es lo que ata peticiones sueltas a una misma sesión.**")
hSS = Heading("Session scope")
tSS = Text("Con scope **session**, cada usuario tiene su propia instancia del bean y la reutiliza mientras dura su sesión:")
figSS = Figure("Una instancia por usuario, viva durante toda su sesión.", [g1, g2], "column")
g1 = Group([sa, a4, ca], "row")
sa = Chip("Sesión de Ana", "grey", "user")
a4 = Arrow()
ca = Chip("CarritoCompra A", "cyan", "package")
g2 = Group([sj, a5, cb], "row")
sj = Chip("Sesión de Jose", "grey", "user")
a5 = Arrow()
cb = Chip("CarritoCompra B", "cyan", "package")
codeSS = CodeBlock("@Component\n@SessionScope\npublic class CarritoCompra { }", "java", "CarritoCompra.java")
hComp = Heading("Comparación de scopes")
tWeb = Text("`request`, `session` y `application` solo existen en aplicaciones web: en una de consola no hay peticiones ni sesiones.")
tabla = Table(["Scope", "Instancias", "Cuándo usarlo"], [["`singleton`", "una, compartida por toda la aplicación", "por defecto"], ["`prototype`", "una nueva cada vez que se pide el bean", "objetos con estado propio"], ["`request`", "una por petición HTTP", "datos que solo viven durante una petición"], ["`session`", "una por sesión de usuario", "datos del usuario entre peticiones (carrito, login)"], ["`application`", "una por aplicación web", "igual que singleton, pero solo en web"]])
hSt = Heading("Stateless y stateful")
tSt = Text("Describen si el servidor guarda información del usuario entre peticiones.")
dl = DescriptionList([dsStateless, dsStateful])
dsStateless = DescriptionItem("Stateless", "Cada petición lleva todo lo que necesita y el servidor no guarda nada del usuario. Por ejemplo, una API en la que el cliente manda su credencial en cada llamada.")
dsStateful = DescriptionItem("Stateful", "El servidor guarda información del usuario entre peticiones. Una sesión HTTP lo es.")
tRegla = Text("La regla práctica con Spring: los beans `singleton` son stateless (compartidos, sin datos de petición en sus campos), y el estado de cada usuario vive en un bean de scope `request` o `session`.")
hExp = Heading("Para explorar")
tExplore = Text("- [Bean scopes en la documentación de Spring](https://docs.spring.io/spring-framework/reference/core/beans/factory-scopes.html)\n- [Web scopes y el proxy de sesión](https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-servlet/container-config.html)")
