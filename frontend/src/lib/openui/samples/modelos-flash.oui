root = Page([intro, h_ax, axes, veh, h_pot, p_pot, dia, end_dia, tabla, end_tabla, h_rep, p_rep, tabla2, end_tabla2, p_plan, tip, h_oc, p_oc, code1, p_oc2, h_ctx, p_ctx, p_ctx2, h_fut, p_fut, h_exp, links])
intro = Text("Un agente es un modelo con herramientas. El **modelo** es el que piensa, y no hay uno mejor para todo: los hay más listos y más caros, y otros rápidos y baratos que para muchas cosas bastan.")
h_ax = Heading("Qué cambia entre modelos")
axes = DescriptionList([c_cap, c_rap, c_pre, c_ctx, c_raz])
c_cap = DescriptionItem("Capacidad", "Cuántos pasos seguidos acierta sin perderse. Se mide con pruebas (benchmarks), como SWE-bench.")
c_rap = DescriptionItem("Rapidez", "Lo que tarda en empezar a responder. En un agente, que da muchas vueltas, se nota.")
c_pre = DescriptionItem("Precio", "Lo que cuesta cada millón de tokens, de entrada y de salida.")
c_ctx = DescriptionItem("Contexto", "Cuánto texto le cabe a la vez.")
c_raz = DescriptionItem("Razonamiento", "Si piensa antes de responder. Acierta más en lo difícil, pero tarda y cuesta más.")
veh = Text("Piensa en vehículos: una furgoneta pequeña para repartir por el barrio, un camión para una mudanza. No se coge el camión para comprar el pan.")
h_pot = Heading("No siempre el más potente")
p_pot = Text("Pagar más no siempre compra más calidad. En estos seis modelos el acierto es casi el mismo, en torno al 80 % en SWE-bench; lo que cambia de verdad es el coste por tarea.")
dia = Diagram("Calidad frente a coste por tarea", brief_dia, null, "<svg viewBox=\"0 0 640 440\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Calidad frente a coste por tarea\">\n  <defs>\n    <marker id=\"punta\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\">\n      <path d=\"M0,0 L10,5 L0,10 Z\" fill=\"var(--color-border-strong)\"/>\n    </marker>\n  </defs>\n\n  <g style=\"--diagram-color: var(--color-fg-muted)\">\n    <path class=\"diagram-part\" d=\"M90,68 L590,68 L590,131 C520,133 460,138 380,155 C245,195 175,260 110,345 L90,360 Z\"/>\n  </g>\n  <text class=\"diagram-text\" x=\"215\" y=\"108\" text-anchor=\"middle\">Zona no alcanzable</text>\n\n  <line class=\"diagram-line\" x1=\"90\" y1=\"360\" x2=\"600\" y2=\"360\" marker-end=\"url(#punta)\"/>\n  <line class=\"diagram-line\" x1=\"90\" y1=\"360\" x2=\"90\" y2=\"58\" marker-end=\"url(#punta)\"/>\n  <text class=\"diagram-label\" x=\"345\" y=\"400\" text-anchor=\"middle\">Coste por tarea</text>\n  <text class=\"diagram-label\" x=\"48\" y=\"205\" text-anchor=\"middle\" transform=\"rotate(-90 48 205)\">Calidad</text>\n\n  <path class=\"diagram-emphasis\" fill=\"none\" stroke-width=\"2.5\" d=\"M110,345 C175,260 245,195 380,155 C460,138 520,133 590,131\"/>\n  <text class=\"diagram-label\" x=\"500\" y=\"162\" text-anchor=\"middle\">Frontera de calidad</text>\n\n  <circle class=\"diagram-part\" cx=\"160\" cy=\"320\" r=\"7\" style=\"--diagram-color: #2563eb\"/>\n  <text class=\"diagram-label\" x=\"176\" y=\"325\">Sin revisar</text>\n\n  <circle class=\"diagram-part\" cx=\"330\" cy=\"245\" r=\"7\" style=\"--diagram-color: #0891b2\"/>\n  <text class=\"diagram-label\" x=\"330\" y=\"272\" text-anchor=\"middle\">Prueba automática</text>\n\n  <circle class=\"diagram-part\" cx=\"500\" cy=\"200\" r=\"7\" style=\"--diagram-color: #db2777\"/>\n  <text class=\"diagram-label\" x=\"500\" y=\"228\" text-anchor=\"middle\">Revisión a mano</text>\n</svg>")
brief_dia = "Diagrama de dispersión con seis puntos, uno por modelo. Eje X: coste por tarea resuelta, en dólares, de $0,20 a $74. Eje Y: calidad en SWE-bench Verified, del 70 % al 85 %, con una banda gris fina marcando el 80 %. Puntos en azul, etiquetados con el nombre del modelo: DeepSeek V4 Pro ($0,20; 79,3 %), Qwen3.5 ($0,46; 80,2 %), MiniMax M2.5 ($1,31; 80,6 %), Gemini 3.1 Pro ($11; 80,8 %), GPT-5.4 ($18; 80,6 %) y Claude Opus 4.6 ($74; 80,8 %). Los puntos quedan en una línea casi horizontal: la calidad apenas sube mientras el coste se multiplica por 370. Lo que hay que notar: el precio sube mucho y el acierto casi nada."
end_dia = Text("**Pagar más no compra más aciertos: la línea de la calidad es casi plana.**")
tabla = Table(["Modelo", "SWE-bench Verified", "Coste por tarea resuelta"], [f1, f2, f3, f4, f5, f6], "Datos de AgentMarketCap, abril de 2026, sobre 2 millones de tokens por tarea. Cambian a menudo.")
f1 = ["DeepSeek V4 Pro", "79,3 %", "$0,20"]
f2 = ["Qwen3.5", "80,2 %", "$0,46"]
f3 = ["MiniMax M2.5", "80,6 %", "$1,31"]
f4 = ["Gemini 3.1 Pro", "80,8 %", "$11"]
f5 = ["GPT-5.4", "80,6 %", "$18"]
f6 = ["Claude Opus 4.6", "80,8 %", "$74"]
end_tabla = Text("**El más caro cuesta 370 veces más que el más barato, por el mismo acierto.**")
h_rep = Heading("Repartir el trabajo")
p_rep = Text("Lo interesante no es usar siempre el modelo más potente, sino darle a cada tarea el que le vale.")
tabla2 = Table(["Lo que haces", "Con qué"], [r1, r2, r3], "El modelo se elige por tarea, no para todo el trabajo.")
r1 = ["Autocompletar, resumir, renombrar, un test sencillo", "barato y rápido"]
r2 = ["Una feature normal, leyendo el código", "el de en medio"]
r3 = ["Depurar algo difícil, decidir la arquitectura, un refactor grande", "el más potente"]
end_tabla2 = Text("**Dar a cada tarea el modelo que le basta ahorra sin perder calidad.**")
p_plan = Text("Una práctica común: el más listo hace el **plan** y el barato lo **ejecuta**. En el plan se decide bien o mal; ejecutar es seguir unos pasos, que no necesita tanta cabeza.")
tip = Callout("tip", "Para el usuario promedio no hace falta comerse la cabeza: coge uno bueno y listo. Saberlo vale para optimizar, bajando de modelo en lo fácil.")
h_oc = Heading("Cómo se elige en OpenCode")
p_oc = Text("En la terminal, `/models` abre el selector dentro del chat. También se puede fijar al arrancar o dejarlo en la configuración.")
code1 = CodeBlock("opencode models                     # lista los modelos que tienes\nopencode --model proveedor/modelo   # arranca con ese", "bash", "Terminal")
p_oc2 = Text("En `opencode.json` se deja el modelo por defecto, y `opencode stats --models` enseña lo que gastas con cada uno.")
h_ctx = Heading("El contexto se llena")
p_ctx = Text("A un modelo solo le cabe un trozo de conversación. Cuando la charla se hace muy larga, se pierde: cuesta más y acierta menos. Es como una mesa: con dos papeles los ves, con doscientos no encuentras nada.")
p_ctx2 = Text("Por eso el agente resume lo viejo, y conviene abrir una sesión nueva para otro tema.")
h_fut = Heading("A dónde va esto")
p_fut = Text("Además de generalistas cada vez más listos, van a crecer los **pequeños y específicos**, buenos en una sola cosa. Es como un equipo: a cada recado, quien mejor lo hace.")
h_exp = Heading("Para explorar")
links = Text("- [Modelos en OpenCode](https://opencode.ai/docs/models/): el selector, la configuración y las estadísticas.\n- [models.dev](https://models.dev): el catálogo de modelos y proveedores.\n- [Artificial Analysis](https://artificialanalysis.ai/): calidad frente a coste.\n- [SWE-bench](https://www.swebench.com/): la prueba de código que enseña la gráfica.")
