root = Page([intro, problemaHeading, problemaText, requestFigure, controllerHeading, controllerText, controllerCode, routesHeading, routeText, routeCode, routeAfter, multipleHeading, multipleText, multipleCode, prefixHeading, prefixText, prefixCode, varHeading, varText, varCode, queryHeading, queryText, queryCode, querySampleText, queryTable, optionalText, optionalCode, modelHeading, modelText, modelCode, viewHeading, viewText, viewTable, viewAfter, staticHeading, staticText, exploreHeading, exploreText])
intro = Text("Cuando el navegador o Postman pide una URL, el controlador decide qué método la atiende. Sin esa pieza, el servidor no sabe qué responder.")
problemaHeading = Heading("El problema")
problemaText = Text("El cliente manda una petición HTTP a una dirección como `http://localhost:8080/products/` y espera una respuesta. El servidor necesita saber qué método ejecutar para cada dirección.")
requestFigure = Figure("Una petición sale del cliente, llega al controlador y este elige el método para esa ruta.", [clientArea, arrow1, controllerArea, arrow2, responseArea])
clientArea = Area("Cliente", [browserChip, postmanChip], "blue", "globe", "Pide una URL.", "row")
browserChip = Chip("Navegador")
postmanChip = Chip("Postman")
arrow1 = Arrow("GET")
controllerArea = Area("Controlador", [routeChip], "violet", "route", "Elige el método según la ruta.", "row")
routeChip = Chip("@GetMapping(\"/products\")")
arrow2 = Arrow("respuesta")
responseArea = Area("Respuesta", [viewChip, dataChip], "cyan", "server", "HTML o JSON.", "row")
viewChip = Chip("Vista HTML")
dataChip = Chip("JSON")
controllerHeading = Heading("Controlador")
controllerText = Text("Un **controlador** es la clase que recibe las peticiones HTTP del cliente y decide qué hacer con ellas. Se marca con `@Controller`, y Spring lo crea como un bean (ver [Spring y el contenedor](spring-y-contenedor.md)).")
controllerCode = CodeBlock("@Controller\npublic class HomeController { }", "java", "HomeController.java")
routesHeading = Heading("Rutas")
routeText = Text("Una **ruta** es la dirección que atiende un método. `@GetMapping` asocia una ruta a un método para las peticiones GET, las de abrir una página:")
routeCode = CodeBlock("@Controller\npublic class HomeController {\n\n    @GetMapping(\"/\")\n    public String index() {\n        return \"index\";   // templates/index.html\n    }\n}", "java", "HomeController.java")
routeAfter = Text("El método devuelve el nombre de la vista, y su archivo sale de `templates/`.")
multipleHeading = Heading("Varias rutas en una")
multipleText = Text("Dentro de la anotación caben varias direcciones entre llaves, separadas por comas. La misma vista responde en `/`, en `/home` y en la raíz sin nada:")
multipleCode = CodeBlock("@GetMapping({\"/\", \"/home\", \"\"})", "java")
prefixHeading = Heading("Prefijo con @RequestMapping")
prefixText = Text("`@RequestMapping` sobre la clase pone un prefijo que se añade a todas sus rutas. Sirve para agrupar y diferenciar las rutas de una parte de la aplicación:")
prefixCode = CodeBlock("@Controller\n@RequestMapping(\"/products\")\npublic class ProductController {\n\n    @GetMapping(\"/\")             // /products/\n    public String showView() { ... }\n\n    @GetMapping(\"/electronics\")  // /products/electronics\n    public String showElectronics() { ... }\n}", "java", "ProductController.java")
varHeading = Heading("Variable en la ruta")
varText = Text("`@PathVariable` coge un trozo variable de la URL y lo pasa como parámetro. Ese trozo se escribe entre llaves:")
varCode = CodeBlock("@GetMapping(\"/products/{id}\")\npublic String showProduct(@PathVariable Long id) { ... }", "java")
queryHeading = Heading("Parámetro en la query")
queryText = Text("Un trozo de la ruta va con `@PathVariable`. Lo que va después del `?` va con `@RequestParam`:")
queryCode = CodeBlock("@GetMapping(\"/products\")\npublic String list(@RequestParam String category, Model model) { ... }", "java")
querySampleText = Text("Con esa ruta, `/products?category=libros` deja `category` con el valor `libros`.")
queryTable = Table(["Se escribe", "Se lee con", "Ejemplo"], [["en la ruta: `/products/{id}`", "`@PathVariable`", "`/products/5`"], ["tras el `?`: `?category=libros`", "`@RequestParam`", "`/products?category=libros`"]], "Ruta frente a query")
optionalText = Text("Si el parámetro puede no venir, no lo dejes obligatorio, o el método responde con un 400. Con `required` y un valor por defecto, o con `Optional`, lo recibes como un valor que puede faltar:")
optionalCode = CodeBlock("@RequestParam(required = false, defaultValue = \"todos\") String category\n@RequestParam Optional<String> category   // category.orElse(\"todos\")", "java")
modelHeading = Heading("Pasar datos a la vista")
modelText = Text("El controlador le entrega datos a la plantilla con un objeto `Model`. Cada dato lleva un nombre con el que la plantilla lo usa después:")
modelCode = CodeBlock("@GetMapping(\"/saludo\")\npublic String saludo(Model model) {\n    model.addAttribute(\"nombre\", \"Ana\");\n    return \"saludo\";\n}", "java")
viewHeading = Heading("Con vista o sin vista")
viewText = Text("Según lo que devuelva, hay dos tipos de controlador:")
viewTable = Table(["Anotación", "Devuelve", "Para"], [["`@Controller`", "el nombre de una vista", "una página HTML (MVC)"], ["`@RestController`", "datos, normalmente en JSON", "una API"]], "Controlador con vista y controlador para API")
viewAfter = Text("**En MVC hay vista. En una API hay modelo y controlador, pero no hay vista: el cliente recibe los datos y los pinta él.**")
staticHeading = Heading("Archivos estáticos")
staticText = Text("Las imágenes, el CSS y el JavaScript que no pasan por Thymeleaf van en `static/` (`src/main/resources/static/`).")
exploreHeading = Heading("Para explorar")
exploreText = Text("- [Mapping Requests](https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-requestmapping.html), en la documentación de Spring.\n- [Annotated Controllers](https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann.html): cómo se declara un controlador.")
