root = Page([intro, h_modelo, terms, fig, end1, h_solo, p_solo, solo_chat, end_solo, h_harness, p_harness, agent_replay, end_harness, h_apps, p_apps, table_apps, end_apps, to_explore, next_link])
intro = Text("Un **agente** es un modelo con un harness. El modelo piensa; el harness le da herramientas para trabajar en tu proyecto.")
h_modelo = Heading("Modelo y harness", 2)
terms = DescriptionList([d_modelo, d_harness, d_agente])
d_modelo = DescriptionItem("Modelo", "La IA que piensa, como la que hay detrás de ChatGPT. Solo recibe texto y devuelve texto.")
d_harness = DescriptionItem("Harness", "Lo que le das al modelo para que pueda trabajar: herramientas (leer archivos, editarlos, ejecutar comandos), instrucciones y permisos. No lo montas tú: aplicaciones como Claude Code ya lo traen.")
d_agente = DescriptionItem("Agente", "Modelo + harness.")
fig = Figure("Un agente: el modelo dentro de un harness que le da herramientas, instrucciones y permisos, entre tú y tu proyecto.", [you, a1, harness, a2, project])
you = Chip("Tú", "grey", "user")
a1 = Arrow(null, true)
harness = Area("Harness", [model, t1, t2, t3], "cyan", null, "Lo que le das al modelo.")
model = Chip("Modelo", "violet", "brain", "piensa")
t1 = Label("Leer archivos", "file-code")
t2 = Label("Editar archivos", "file-pen")
t3 = Label("Ejecutar comandos", "terminal")
a2 = Arrow(null, true)
project = Chip("Tu proyecto", "yellow", "folder")
end1 = Text("**El modelo piensa; el harness es lo que le permite actuar en tu proyecto.**")
h_solo = Heading("Solo el modelo", 2)
p_solo = Text("Pídele a un modelo solo que no deje crear productos sin nombre en la práctica de la tienda. No ha visto tu proyecto, así que contesta con código para pegar. La sesión es un ejemplo inventado.")
solo_chat = Chat([user1, assistant1])
user1 = ChatMessage("user", "No dejes crear un producto sin nombre.")
assistant1 = ChatMessage("assistant", "Añade esta validación en el controlador:\n\n```java\nif (product.getName() == null || product.getName().isBlank()) {\n    return ResponseEntity.badRequest().build();\n}\n```")
end_solo = Text("**Solo, el modelo te dice qué hacer, pero lo haces tú.**")
h_harness = Heading("Con harness", 2)
p_harness = Text("Ahora, el mismo modelo con un harness alrededor. Fíjate en que busca, lee, edita y pasa los tests antes de contestar. La sesión es un ejemplo inventado.")
agent_replay = AgentReplay([ap1, as1, as2, as3, as4, aa1])
ap1 = AgentPrompt("No dejes crear un producto sin nombre.", "Misma petición que antes.")
as1 = AgentStep("Buscando ProductController.java", "Encontrado ProductController.java", "search", null, "Primero localiza el archivo.")
as2 = AgentStep("Leyendo ProductController.java", "Leído ProductController.java", "file-text", null, "Lee el código antes de tocarlo.")
as3 = AgentStep("Editando ProductController.java", "Añadida validación de nombre", "file-pen", null, "Edita el archivo.")
as4 = AgentStep("Ejecutando ./mvnw test", "Tests: 4 pasan", "flask", "Tests run: 4, Failures: 0", "Comprueba su propio trabajo.")
aa1 = AgentAnswer("Hecho. POST /products responde 400 si falta el nombre.", null, "El modelo es el mismo; el harness le permite trabajar en tu proyecto.")
end_harness = Text("**Con un harness, lo hace él en tu proyecto, y ves cada paso.**")
h_apps = Heading("Aplicaciones que traen el harness montado", 2)
p_apps = Text("Se instalan en tu ordenador y se usan desde la terminal.")
table_apps = Table(["Aplicación", "Qué necesitas"], [["`OpenCode`", "nada, es gratis"], ["`Claude Code`", "pagar Claude"], ["`Codex`", "pagar ChatGPT"]])
end_apps = Text("**Cada una trae el harness ya montado: eliges la que ya tengas o la gratuita.**")
to_explore = Heading("Para explorar", 2)
next_link = Text("Siguiente: [Tu primer agente](../opencode/)")
