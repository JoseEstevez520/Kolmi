root = Page([intro, hSingleton, pSingleton, figSingleton, warnSingleton, codeSingleton, hPrototype, pPrototype, codeProtoJava, codeProtoTree, hWeb, pWeb, tableWeb, hHttp, pHttp, codeRequests, pHttp2, figSesion, hSesion, pSesion, codeSesionTree, codeSesionJava, noteSesion, hEstado, pEstado, defsEstado, reglaEstado, hExplorar, links])
intro = Text("Un **bean** es un objeto que Spring crea y gestiona. Su **scope** decide cuándo Spring crea la instancia y cuánto la reutiliza; si no indicas nada, el scope es `singleton`.")
hSingleton = Heading("Singleton")
pSingleton = Text("Spring crea **una sola instancia** del bean y la comparte con todo el que la pida. Es el scope por defecto: `@Service` y `@Component` ya son singleton.")
figSingleton = Figure("Una única instancia del bean, repartida entre todos los que la piden.", [inst, a1, consumidores])
inst = Chip("Una instancia", "violet", "package")
a1 = Arrow()
consumidores = Group([c1, c2, c3], "column")
c1 = Chip("PedidoController", "blue")
c2 = Chip("PedidoService", "blue")
c3 = Chip("FacturaService", "blue")
warnSingleton = Callout("warning", "Al compartir una única instancia, un bean singleton **no debe guardar estado de una petición en sus campos**. Si `PedidoService` guarda el usuario actual en un atributo, la siguiente petición lo pisa.")
codeSingleton = CodeBlock("@Service  // singleton: una instancia para toda la aplicación\npublic class PedidoService {\n    private PedidoRepository repo;   // bien: la dependencia no cambia\n    // private Usuario usuario;      // mal: lo compartirían todas las peticiones\n}", "java", "PedidoService.java")
hPrototype = Heading("Prototype")
pPrototype = Text("Spring crea **una instancia nueva cada vez** que se pide el bean. Sirve para objetos con estado propio que no quieres compartir.")
codeProtoJava = CodeBlock("@Component\n@Scope(\"prototype\")\npublic class InformeBuilder { }", "java", "InformeBuilder.java")
codeProtoTree = CodeBlock("Petición → InformeBuilder A\nPetición → InformeBuilder B\nPetición → InformeBuilder C", "text")
hWeb = Heading("Scopes web")
pWeb = Text("En una aplicación web hay scopes ligados a la petición y a la sesión del usuario:")
tableWeb = Table(["Scope", "Una instancia por…", "Cuándo usarlo"], [["`singleton`", "aplicación", "por defecto"], ["`prototype`", "cada vez que se pide", "objetos con estado propio"], ["`request`", "petición HTTP", "datos que solo viven durante una petición"], ["`session`", "sesión de usuario", "datos del usuario entre peticiones (carrito, login)"], ["`application`", "aplicación web", "igual que singleton, pero solo en web"]])
hHttp = Heading("Sesión HTTP")
pHttp = Text("HTTP no recuerda nada: cada petición llega sola, sin saber de las anteriores. Para que el servidor sepa que varias peticiones son del mismo usuario existe la **sesión HTTP**:")
codeRequests = CodeBlock("Petición 1  POST /login\nPetición 2  GET  /perfil\nPetición 3  GET  /carrito", "text")
pHttp2 = Text("Al empezar, el servidor crea una sesión con un identificador y se lo manda al navegador en una cookie (`JSESSIONID`). En cada petición siguiente el navegador manda la cookie y el servidor localiza la sesión.")
figSesion = Figure("El navegador manda la cookie de sesión y el servidor encuentra la sesión por su identificador.", [nav, a2, servidor])
nav = Chip("Navegador", "blue", "globe")
a2 = Arrow("JSESSIONID=abc123")
servidor = Area("Servidor", [sesion], "violet", "server")
sesion = Label("sesión abc123: { usuario: \"usuario1\" }", "key")
hSesion = Heading("Session scope")
pSesion = Text("El scope **session** da a cada usuario su propia instancia del bean y la reutiliza mientras dura su sesión:")
codeSesionTree = CodeBlock("Sesión de Usuario A  → CarritoCompra A\nSesión de Usuario B  → CarritoCompra B", "text")
codeSesionJava = CodeBlock("@Component\n@SessionScope\npublic class CarritoCompra { }", "java", "CarritoCompra.java")
noteSesion = Text("Solo existe en aplicaciones web: en una de consola no hay sesión.")
hEstado = Heading("Stateful y stateless")
pEstado = Text("Describen si la aplicación recuerda información entre peticiones.")
defsEstado = DescriptionList([d1, d2])
d1 = DescriptionItem("Stateless", "Cada petición lleva todo lo que necesita y el servidor no guarda nada del usuario. Ejemplo: una API con un token en cada llamada.")
d2 = DescriptionItem("Stateful", "El servidor guarda información del usuario entre peticiones. Una sesión HTTP es stateful.")
reglaEstado = Text("La regla práctica con Spring: los beans **singleton son stateless**, y el estado de cada usuario vive en un bean de scope `request` o `session`.")
hExplorar = Heading("Para explorar")
links = Cards([card1, card2])
card1 = Card("Bean scopes en Spring", "Todos los scopes, en la documentación oficial.", "https://docs.spring.io/spring-framework/reference/core/beans/factory-scopes.html")
card2 = Card("Web scopes y el proxy de sesión", "Los scopes web y el proxy de sesión, en la documentación oficial.", "https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-servlet/container-config.html")