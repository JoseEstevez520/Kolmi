root = Page([intro, h1, terms, fig, end1, h2, p2, beforeChat, chat, endChat, beforeAgent, session, endAgent, h3, p3, apps, h4, explore])
intro = Text("El **modelo** es el cerebro; el **harness** le da herramientas. Juntos forman un **agente**.")
h1 = Heading("Modelo y harness")
terms = DescriptionList([d1, d2, d3])
d1 = DescriptionItem("Modelo", "La IA que piensa, como la que hay detrás de ChatGPT. Solo recibe texto y devuelve texto.")
d2 = DescriptionItem("Harness", "Lo que le das al modelo para que pueda trabajar: herramientas (leer tus archivos, editarlos, ejecutar comandos), instrucciones y permisos. Hay aplicaciones que lo traen ya montado, como Claude Code.")
d3 = DescriptionItem("Agente", "Modelo + harness.")
fig = Figure("Un agente: el modelo dentro de un harness que le da herramientas, entre tú y tu proyecto.", [you, a1, harness, a2, project])
you = Chip("Tú", "grey", "user")
a1 = Arrow(null, true)
harness = Area("Harness", [modelo, t1, t2, t3], "cyan", null, "Lo que le das al modelo.", "column")
modelo = Chip("Modelo", "violet", "brain", "piensa")
t1 = Label("Leer archivos", "file-code")
t2 = Label("Editar archivos", "file-pen")
t3 = Label("Ejecutar comandos", "terminal")
a2 = Arrow(null, true)
project = Chip("Tu proyecto", "yellow", "folder")
end1 = Text("**El modelo piensa; el harness es lo que le deja actuar en tu proyecto.**")
h2 = Heading("La misma petición, dos veces")
p2 = Text("Petición: no dejar crear productos sin nombre en la práctica de la tienda. Las sesiones son un ejemplo inventado.")
beforeChat = Text("Primero, el modelo solo. No ha visto tu proyecto.")
chat = Chat([q, a])
q = ChatMessage("user", "No dejes crear productos sin nombre.")
a = ChatMessage("assistant", "No conozco tu proyecto, así que te doy el código para pegar. Los tests los pasas tú.")
endChat = Text("**Solo, el modelo te dice qué hacer, pero lo haces tú.**")
beforeAgent = Text("Ahora el mismo modelo, con un harness alrededor. Fíjate en que busca, lee, edita y ejecuta los tests antes de contestar.")
session = AgentReplay([ask, s1, s2, s3, s4, answer])
ask = AgentPrompt("No dejes crear productos sin nombre.", "La misma petición de antes.")
s1 = AgentStep("Buscando el controlador de productos", "Encontrado el controlador de productos", "search", null, "No conoce tu proyecto: lo busca.")
s2 = AgentStep("Leyendo el archivo", "Leído", "file-text")
s3 = AgentStep("Editando el archivo", "Editado", "file-pen", null, "Cambia un archivo de tu proyecto.", "ask-allow")
s4 = AgentStep("Ejecutando los tests", "Los tests pasan", "flask", null, "Comprueba su propio trabajo.")
answer = AgentAnswer("Hecho. Ya no se pueden crear productos sin nombre.", null, "El modelo es el mismo; el harness le deja trabajar en tu proyecto.")
endAgent = Text("**Con un harness, lo hace él en tu proyecto, y ves cada paso.**")
h3 = Heading("Aplicaciones que traen el harness montado")
p3 = Text("Se instalan en tu ordenador y se usan desde la terminal. El harness ya viene montado, así que no lo montas tú.")
apps = Table(["Aplicación", "Qué necesitas"], [["OpenCode", "nada, es gratis"], ["Claude Code", "pagar Claude"], ["Codex", "pagar ChatGPT"]], "Aplicaciones con el harness ya montado")
h4 = Heading("Para explorar")
explore = Text("- Instalar uno y verlo en la práctica: la siguiente página, [Tu primer agente](../opencode/).\n- Claude Code y Codex: documentación oficial de cada aplicación.")
