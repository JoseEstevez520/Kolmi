root = Page([intro, hSingleton, pSingleton, codeSingleton, aviso, figSingleton, endSingleton, hPrototype, pPrototype, codePrototype, figPrototype, endPrototype, hWeb, pWeb, tablaWeb, endTabla, hSesion, pSesion, figSesion, endSesion, hSessionScope, pSessionScope, codeSessionScope, figSessionScope, endSessionScope, hEstado, pEstado, dlEstado, hExplorar, links])
intro = Text("Un **scope** decide cuándo Spring crea una instancia de un bean y cuánto la reutiliza. Un **bean** es un objeto que Spring crea y gestiona; si no dices nada, su scope es `singleton`.")
hSingleton = Heading("Singleton", 2)
pSingleton = Text("El scope **singleton** crea **una sola instancia** del bean y la comparte con todo el que la pida. Es el scope por defecto: `@Service` y `@Component` ya son singleton.")
codeSingleton = CodeBlock("@Service  // singleton: una instancia para toda la aplicación\npublic class PedidoService {\n    private PedidoRepository repo;   // bien: la dependencia no cambia\n    // private Usuario usuario;      // mal: lo compartirían todas las peticiones\n}", "java", "PedidoService.java")
aviso = Callout("warning", "Un bean singleton **no debe guardar datos de una petición en sus campos**: todos comparten la misma instancia y la petición siguiente los pisa.")
figSingleton = Figure("Una única instancia compartida por todos los beans que la piden.", [unaInstancia, flechaSingleton, consumidores])
unaInstancia = Chip("Una instancia", "blue", "package")
flechaSingleton = Arrow("la misma")
consumidores = Group([consA, consB, consC], "column")
consA = Chip("PedidoController", "grey")
consB = Chip("PedidoService", "grey")
consC = Chip("FacturaService", "grey")
endSingleton = Text("**Todos los que piden el bean reciben la misma instancia.**")
hPrototype = Heading("Prototype", 2)
pPrototype = Text("El scope **prototype** crea **una instancia nueva cada vez** que se pide el bean. Sirve para objetos con estado propio que no quieres compartir.")
codePrototype = CodeBlock("@Component\n@Scope(\"prototype\")\npublic class InformeBuilder { }", "java", "InformeBuilder.java")
figPrototype = Figure("Tres peticiones y tres instancias distintas de InformeBuilder.", [peticionesProto, flechaProto, instanciasProto], "row")
peticionesProto = Group([pe1, pe2, pe3], "column")
pe1 = Chip("Petición 1", "grey")
pe2 = Chip("Petición 2", "grey")
pe3 = Chip("Petición 3", "grey")
flechaProto = Arrow("nueva instancia")
instanciasProto = Group([in1, in2, in3], "column")
in1 = Chip("InformeBuilder A", "blue")
in2 = Chip("InformeBuilder B", "blue")
in3 = Chip("InformeBuilder C", "blue")
endPrototype = Text("**Cada petición construye su propio objeto y no lo comparte con nadie.**")
hWeb = Heading("Scopes web", 2)
pWeb = Text("En una aplicación web hay más scopes, ligados a la petición y a la sesión. Elige por lo que dura el dato:")
tablaWeb = Table(["Scope", "Una instancia por…", "Cuándo usarlo"], [["`singleton`", "aplicación", "por defecto"], ["`prototype`", "cada vez que se pide", "objetos con estado propio"], ["`request`", "petición HTTP", "datos que solo viven durante una petición"], ["`session`", "sesión de usuario", "datos del usuario entre peticiones (carrito, login)"], ["`application`", "aplicación web", "igual que `singleton`, pero solo en web"]], "Scopes de Spring")
endTabla = Text("**Cuanto más corto es el scope, menos vive la instancia.**")
hSesion = Heading("Sesión HTTP", 2)
pSesion = Text("HTTP no recuerda nada: cada petición llega sola, sin saber de las anteriores. Una **sesión HTTP** es la forma de que el servidor se acuerde de quién eres entre peticiones. Al empezar, el servidor abre una sesión con un identificador y lo manda al navegador en una cookie, `JSESSIONID`; en cada petición siguiente el navegador manda la cookie y el servidor localiza la sesión.")
figSesion = Figure("El navegador manda la cookie con el id y el servidor localiza la sesión.", [navegador, flechaCookie, servidor], "row")
navegador = Chip("Navegador", "grey", "globe")
flechaCookie = Arrow("JSESSIONID=abc123")
servidor = Area("Servidor", [etiquetaSesion], "violet", "server", "Busca la sesión por el id.")
etiquetaSesion = Label("sesión abc123: datos del usuario", "user")
endSesion = Text("**La cookie lleva el id; el estado del usuario se queda en el servidor.**")
hSessionScope = Heading("Session scope", 2)
pSessionScope = Text("El scope **session** da a cada usuario su propia instancia del bean y la reutiliza mientras dura su sesión. Solo existe en aplicaciones web; en una de consola no hay sesión.")
codeSessionScope = CodeBlock("@Component\n@SessionScope\npublic class CarritoCompra { }", "java", "CarritoCompra.java")
figSessionScope = Figure("Cada sesión tiene su propia instancia de CarritoCompra.", [sesionA, sesionB], "row")
sesionA = Area("Sesión de un usuario", [carritoA], "violet", "user")
carritoA = Chip("CarritoCompra A", "blue")
sesionB = Area("Sesión de otro usuario", [carritoB], "violet", "user")
carritoB = Chip("CarritoCompra B", "blue")
endSessionScope = Text("**El mismo bean, una instancia por sesión: dos usuarios no comparten el carrito.**")
hEstado = Heading("Stateful y stateless", 2)
pEstado = Text("Estos dos términos dicen si el servidor recuerda algo entre peticiones.")
dlEstado = DescriptionList([dStateless, dStateful, dRegla])
dStateless = DescriptionItem("Stateless", "Cada petición lleva todo lo que necesita y el servidor no guarda nada del usuario. Ejemplo: una API con un token en cada llamada.")
dStateful = DescriptionItem("Stateful", "El servidor guarda información del usuario entre peticiones. Una sesión HTTP es stateful.")
dRegla = DescriptionItem("Regla en Spring", "Los beans `singleton` son stateless; el estado de cada usuario vive en un bean de scope `request` o `session`.")
hExplorar = Heading("Para explorar", 2)
links = Text("- [Bean scopes](https://docs.spring.io/spring-framework/reference/core/beans/factory-scopes.html), en la documentación de Spring.\n- [Web scopes y el proxy de sesión](https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-servlet/container-config.html), en la documentación de Spring.")
