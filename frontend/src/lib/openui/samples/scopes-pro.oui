root = Page([intro, hSingleton, pSingleton, figSingleton, pFigSingletonConcl, pCodeSingleton, codeSingleton, warnSingleton, pSingletonConcl, hPrototype, pPrototype, codeProto, figProto, pProtoConcl, hWebScopes, pWebScopes, tableWebScopes, pTableConcl, hSesion, pSesion, figSesion, pSesionConcl, hSessionScope, pSessionScope, figSessionScope, pSessionFigConcl, codeCarrito, pCarritoConcl, hState, pState, descState, pStateRule, hExplore, pExplore])
intro = Text("Un **scope** es la regla que decide cuándo Spring crea una instancia de un bean y cuánto la reutiliza. Si no dices nada, el scope es **singleton**.")
hSingleton = Heading("Singleton")
pSingleton = Text("El scope **singleton** hace que Spring cree **una sola instancia** del bean y la comparta entre todo el que la pida.")
figSingleton = Figure("Una instancia compartida entre PedidoController, PedidoService y FacturaService.", [unaInstancia, arrow1, consumidores], "row")
unaInstancia = Chip("Una instancia", "violet", "layers")
arrow1 = Arrow()
consumidores = Group([pedidoController, pedidoService, facturaService], "column")
pedidoController = Chip("PedidoController", "cyan")
pedidoService = Chip("PedidoService", "cyan")
facturaService = Chip("FacturaService", "cyan")
pFigSingletonConcl = Text("**Es el scope por defecto: `@Service` o `@Component` ya son singleton.**")
pCodeSingleton = Text("El código muestra la regla: la dependencia no cambia; el estado de petición no va en campos.")
codeSingleton = CodeBlock("@Service  // singleton: una instancia para toda la aplicación\npublic class PedidoService {\n    private PedidoRepository repo;   // bien: la dependencia no cambia\n    // private Usuario usuario;      // mal: lo compartirían todas las peticiones\n}", "java", "PedidoService.java")
warnSingleton = Callout("warning", "Como todos comparten la misma instancia, un bean singleton **no debe guardar estado de una petición en sus campos**. Si `PedidoService` guarda el usuario actual en un atributo, la siguiente petición lo pisa.")
pSingletonConcl = Text("**Un bean singleton es compartido: sin estado de petición en campos.**")
hPrototype = Heading("Prototype")
pPrototype = Text("El scope **prototype** hace que Spring cree **una instancia nueva cada vez** que se pide el bean.")
codeProto = CodeBlock("@Component\n@Scope(\"prototype\")\npublic class InformeBuilder { }", "java", "InformeBuilder.java")
figProto = Figure("Cada petición recibe un InformeBuilder nuevo.", [pair1, pair2, pair3], "column")
pair1 = Group([p1, a1, b1], "row")
p1 = Chip("Petición 1", "grey", "send")
a1 = Arrow()
b1 = Chip("InformeBuilder A", "cyan")
pair2 = Group([p2, a2, b2], "row")
p2 = Chip("Petición 2", "grey", "send")
a2 = Arrow()
b2 = Chip("InformeBuilder B", "cyan")
pair3 = Group([p3, a3, b3], "row")
p3 = Chip("Petición 3", "grey", "send")
a3 = Arrow()
b3 = Chip("InformeBuilder C", "cyan")
pProtoConcl = Text("Prototype sirve para objetos con estado propio que no quieres compartir.")
hWebScopes = Heading("Scopes web")
pWebScopes = Text("En una aplicación web hay más scopes, ligados a la petición y a la sesión.")
tableWebScopes = Table(["Scope", "Una instancia por…", "Cuándo usarlo"], [["`singleton`", "aplicación", "por defecto"], ["`prototype`", "cada vez que se pide", "objetos con estado propio"], ["`request`", "petición HTTP", "datos que solo viven durante una petición"], ["`session`", "sesión de usuario", "datos del usuario entre peticiones (carrito, login)"], ["`application`", "aplicación web", "igual que singleton, pero solo en web"]])
pTableConcl = Text("**La elección depende de cuánto debe vivir el estado.**")
hSesion = Heading("Sesión HTTP", 3)
pSesion = Text("Una **sesión HTTP** es la forma de que el servidor se acuerde de quién eres entre peticiones. HTTP, por sí solo, no recuerda nada: cada petición llega sola, sin saber de las anteriores.")
figSesion = Figure("El navegador manda la cookie JSESSIONID en cada petición y el servidor localiza la sesión.", [navegador, arrowSesion, servidorArea], "row")
navegador = Chip("Navegador", "grey", "globe")
arrowSesion = Arrow("JSESSIONID=abc123")
servidorArea = Area("Servidor", [sesionLabel], "blue", "server", null, "column")
sesionLabel = Label("sesión abc123: { usuario: \"ana\" }", "key")
pSesionConcl = Text("**En cada petición siguiente el navegador manda la cookie, y el servidor localiza la sesión.**")
hSessionScope = Heading("Session scope", 3)
pSessionScope = Text("El scope **session** hace que cada usuario tenga su propia instancia del bean, y que se reutilice mientras dura su sesión.")
figSessionScope = Figure("Cada sesión tiene su propio carrito de compra.", [sesionAnaGroup, sesionJoseGroup], "column")
sesionAnaGroup = Group([sesionAna, aAna, carritoA], "row")
sesionAna = Chip("Sesión de Ana", "yellow", "user")
aAna = Arrow()
carritoA = Chip("CarritoCompra A", "cyan", "package")
sesionJoseGroup = Group([sesionJose, aJose, carritoB], "row")
sesionJose = Chip("Sesión de Jose", "yellow", "user")
aJose = Arrow()
carritoB = Chip("CarritoCompra B", "cyan", "package")
pSessionFigConcl = Text("Cada usuario maneja su propia instancia mientras dura su sesión.")
codeCarrito = CodeBlock("@Component\n@SessionScope\npublic class CarritoCompra { }", "java", "CarritoCompra.java")
pCarritoConcl = Text("Solo existe en aplicaciones web; en una de consola no hay sesión.")
hState = Heading("Stateful y stateless")
pState = Text("Estos dos términos describen si la aplicación recuerda información entre peticiones.")
descState = DescriptionList([dStateless, dStateful])
dStateless = DescriptionItem("Stateless", "Cada petición lleva todo lo que necesita y el servidor no guarda nada del usuario. Ejemplo: una API con un token en cada llamada.")
dStateful = DescriptionItem("Stateful", "El servidor guarda información del usuario entre peticiones. Una sesión HTTP es stateful.")
pStateRule = Text("La regla práctica con Spring: **los beans singleton son stateless** (compartidos, sin datos de petición en campos), y el estado de cada usuario vive en un bean de scope `request` o `session`.")
hExplore = Heading("Para explorar")
pExplore = Text("- [Bean scopes en la documentación de Spring](https://docs.spring.io/spring-framework/reference/core/beans/factory-scopes.html)\n- [Web scopes y el proxy de sesión](https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-servlet/container-config.html)")
