# For `docker compose build`: the frontend's build-time vars (Supabase's own, public ones).
# See backend/README.md ("Deploy (Docker)" and "Going public: Tailscale Funnel").
# backend/.env is separate (the API's own secrets, never public).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# VITE_API_URL is not set here: docker-compose.yml bakes in "/api", since nginx
# (frontend/nginx.conf) proxies it to the api container. Same origin, no domain needed.
